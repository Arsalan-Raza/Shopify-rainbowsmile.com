  ],
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What Rainbow Smile Is Doing"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title — main",
      "default": "One village at a time."
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title — italic accent (coral)",
      "default": "Growing exponentially."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body paragraph",
      "default": "<p>We are a startup. We are small. We are honest about that. But we are also the company that created the world\u2019s first Biome Food\u2122 for the oral microbiome. Our commitment to Kenya is not a marketing gesture. It is the ecological logic of what we believe: that a community that leaves people at the fringe impoverishes its own intelligence.</p>"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline (gold)",
      "default": "Love Serves All\u2122 is not a tagline. It is a supply chain."
    },
    {
      "type": "header",
