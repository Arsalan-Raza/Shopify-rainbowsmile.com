{%- liquid
  assign progress_pct = section.settings.progress_current | times: 100.0 | divided_by: section.settings.progress_goal | round
  assign progress_pct_str = progress_pct | append: '%'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --kv-bg:    {{ section.settings.bg_color }};
    --kv-card:  {{ section.settings.card_color }};
    --kv-line:  {{ section.settings.line_color }};
    --kv-cream: {{ section.settings.cream_color }};
    --kv-white: {{ section.settings.white_color }};
    --kv-coral: {{ section.settings.coral_color }};
    --kv-gold:  {{ section.settings.gold_color }};
    --kv-body:  {{ section.settings.body_color }};
    --kv-muted: {{ section.settings.muted_color }};
    --kv-progress: {{ progress_pct_str }};
  }
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} .kvl {
    background: var(--kv-bg);
    padding-block: clamp(44px, 6vw, 80px);
    padding-inline: clamp(20px, 5vw, 48px);
  }

  #shopify-section-{{ section.id }} .kvl * { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .kvl__inner { max-width: 1120px; margin-inline: auto; }

  /* Header */
  #shopify-section-{{ section.id }} .kvl__head { text-align: center; margin-bottom: clamp(30px, 4.5vw, 50px); }

  #shopify-section-{{ section.id }} .kvl__eyebrow {
    margin: 0 0 clamp(14px, 2vw, 20px);
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 400;
    font-size: clamp(13px, 1.1vw, 14px);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--kv-coral);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .kvl__title {
    margin: 0;
    font-family: var(--font-{{ section.settings.display_font }}-family);
    font-weight: 700;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.5px;
    color: var(--kv-cream);
  }

  #shopify-section-{{ section.id }} .kvl__title-accent {
    font-style: italic;
    color: var(--kv-coral);
  }

  #shopify-section-{{ section.id }} .kvl__body {
    margin: clamp(18px, 2.6vw, 26px) auto 0;
    max-width: 700px;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.7;
    color: var(--kv-body);
  }
  #shopify-section-{{ section.id }} .kvl__body p { margin: 0; }

  #shopify-section-{{ section.id }} .kvl__tagline {
    margin: clamp(20px, 3vw, 30px) auto 0;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.5;
    color: var(--kv-gold);
  }

  /* Stat cards */
  #shopify-section-{{ section.id }} .kvl__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 1.8vw, 22px);
    margin-bottom: clamp(34px, 5vw, 56px);
  }

  #shopify-section-{{ section.id }} .kvl__stat {
    background: var(--kv-card);
    border: 1px solid var(--kv-line);
    border-radius: 14px;
    padding: clamp(22px, 3vw, 34px) clamp(18px, 2.4vw, 28px);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .kvl__stat-num {
    margin: 0 0 clamp(14px, 2vw, 20px);
    font-family: var(--font-{{ section.settings.display_font }}-family);
    font-weight: 700;
    font-size: clamp(30px, 3.2vw, 40px);
    line-height: 1;
    color: var(--kv-num-color, var(--kv-coral));
  }

  #shopify-section-{{ section.id }} .kvl__stat-title {
    margin: 0 0 10px;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 700;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.3;
    color: var(--kv-white);
  }

  #shopify-section-{{ section.id }} .kvl__stat-body {
    margin: 0;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(13px, 1.1vw, 14px);
    line-height: 1.6;
    color: var(--kv-body);
  }

  /* Progress */
  #shopify-section-{{ section.id }} .kvl__progress-wrap {
    max-width: 700px;
    margin: 0 auto clamp(34px, 5vw, 56px);
  }

  #shopify-section-{{ section.id }} .kvl__progress-labels {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 12px;
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.8px;
    color: var(--kv-muted);
  }
  #shopify-section-{{ section.id }} .kvl__progress-labels strong { color: var(--kv-gold); font-weight: 700; }

  #shopify-section-{{ section.id }} .kvl__track {
    height: 7px;
    border-radius: 999px;
    background: {{ section.settings.line_color }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .kvl__fill {
    height: 100%;
    width: var(--kv-progress);
    min-width: 14px;
    border-radius: 999px;
    background: var(--kv-gold);
  }

  #shopify-section-{{ section.id }} .kvl__note {
    margin: clamp(14px, 2.2vw, 20px) auto 0;
    max-width: 640px;
    text-align: center;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(15px, 1.3vw, 16px);
    line-height: 1.65;
    color: var(--kv-body);
  }
  #shopify-section-{{ section.id }} .kvl__note p { margin: 0; }
  #shopify-section-{{ section.id }} .kvl__note strong { color: var(--kv-white); font-weight: 400; }

  /* Photos */
  #shopify-section-{{ section.id }} .kvl__photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 1.8vw, 22px);
  }

  #shopify-section-{{ section.id }} .kvl__photo {
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: linear-gradient(160deg, #6b4a2c, #a3764a);
  }

  #shopify-section-{{ section.id }} .kvl__photo img,
  #shopify-section-{{ section.id }} .kvl__photo svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .kvl__stats { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
    #shopify-section-{{ section.id }} .kvl__photos { grid-template-columns: 1fr 1fr; }
    #shopify-section-{{ section.id }} .kvl__photo:first-child { grid-column: span 2; aspect-ratio: 16 / 9; }
  }

  @media (max-width: 520px) {
    #shopify-section-{{ section.id }} .kvl__progress-labels { flex-direction: column; align-items: flex-start; gap: 6px; }
    #shopify-section-{{ section.id }} .kvl__photos { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .kvl__photo:first-child { grid-column: auto; aspect-ratio: 4 / 3; }
    #shopify-section-{{ section.id }} .kvl__photo { aspect-ratio: 4 / 3; }
  }
</style>

<section class="kvl">
  <div class="kvl__inner">

    <header class="kvl__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kvl__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank or section.settings.title_accent != blank -%}
        <h2 class="kvl__title">
          {{- section.settings.title | escape -}}
          {%- if section.settings.title_accent != blank -%}
            <span class="kvl__title-accent"> {{ section.settings.title_accent | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="kvl__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="kvl__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
    </header>

    {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
    {%- if stat_blocks.size > 0 -%}
      <div class="kvl__stats">
        {%- for block in stat_blocks -%}
          <div class="kvl__stat" style="--kv-num-color: {{ block.settings.num_color }};" {{ block.shopify_attributes }}>
            {%- if block.settings.num != blank -%}
              <p class="kvl__stat-num">{{ block.settings.num | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="kvl__stat-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="kvl__stat-body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="kvl__progress-wrap">
      <div class="kvl__progress-labels">
        <span><strong>{{ section.settings.progress_label_current }}</strong> &middot; {{ section.settings.progress_current }} {{ section.settings.progress_unit }}</span>
        <span>Goal: <strong>{{ section.settings.progress_goal }} {{ section.settings.progress_unit }}</strong> by {{ section.settings.progress_goal_date }}</span>
      </div>
      <div
        class="kvl__track"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="{{ section.settings.progress_goal }}"
        aria-valuenow="{{ section.settings.progress_current }}"
        aria-label="{{ section.settings.progress_unit | capitalize }} supported: {{ section.settings.progress_current }} of {{ section.settings.progress_goal }}"
      >
        <div class="kvl__fill"></div>
      </div>
      {%- if section.settings.progress_note != blank -%}
        <div class="kvl__note">{{ section.settings.progress_note }}</div>
      {%- endif -%}
    </div>

    {%- assign photo_blocks = section.blocks | where: 'type', 'photo' -%}
    {%- if photo_blocks.size > 0 -%}
      <div class="kvl__photos">
        {%- for block in photo_blocks -%}
          <div class="kvl__photo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(max-width: 520px) 100vw, (max-width: 860px) 50vw, 33vw"
                alt="{{ block.settings.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Kenya Village",
  "tag": "section",
  "class": "kenya-village-section",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat card",
