{%- style -%}
  /* ── Section spacing ─────────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Dynamic tokens ──────────────────────────────────────────── */
  .rs-mission-{{ section.id }} {
    --mu-eyebrow-color:        {{ section.settings.eyebrow_color }};
    --mu-heading-main-color:   {{ section.settings.heading_main_color }};
    --mu-heading-script-color: {{ section.settings.heading_script_color }};
    --mu-quote-color:          {{ section.settings.quote_color }};
  }

  /* ── Layout ──────────────────────────────────────────────────── */
  .rs-mission-{{ section.id }} .rs-mission__inner {
    text-align: center;
  }

  /* ── Eyebrow ─────────────────────────────────────────────────── */
  .rs-mission-{{ section.id }} .rs-mission__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 clamp(1.75rem, 4vw, 2.5rem);
    color: var(--mu-eyebrow-color);
    font-family: var({{ section.settings.eyebrow_font }});
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
  }

  .rs-mission-{{ section.id }} .rs-mission__eyebrow::before {
    content: "";
    width: 28px;
    height: 2px;
    background: currentColor;
    flex: none;
  }

  /* ── Heading ─────────────────────────────────────────────────── */
  .rs-mission-{{ section.id }} .rs-mission__heading {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1em;
  }

  .rs-mission-{{ section.id }} .rs-mission__heading-main {
    font-family: var({{ section.settings.heading_main_font }});
    font-weight: 700;
    font-size: clamp(44px, 6.5vw, 76px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--mu-heading-main-color);
  }

  .rs-mission-{{ section.id }} .rs-mission__heading-script {
    font-family: var({{ section.settings.heading_script_font }});
    font-weight: 400;
    font-size: clamp(46px, 6.8vw, 80px);
    line-height: 1.05;
    color: var(--mu-heading-script-color);
  }

  /* ── Quote ───────────────────────────────────────────────────── */
  .rs-mission-{{ section.id }} .rs-mission__quote {
    max-width: 64rem;
    margin: clamp(2.25rem, 5vw, 3.5rem) auto 0;
  }

  .rs-mission-{{ section.id }} .rs-mission__quote p {
    margin: 0;
    font-family: var({{ section.settings.quote_font }});
    font-weight: 500;
    font-size: clamp(21px, 2.4vw, 30px);
    line-height: 1.65;
    color: var(--mu-quote-color);
  }

  /* ── Mobile ──────────────────────────────────────────────────── */
  @media screen and (max-width: 749px) {
    .rs-mission-{{ section.id }} .rs-mission__eyebrow {
      gap: 0.5rem;
      letter-spacing: 0.14em;
    }

    .rs-mission-{{ section.id }} .rs-mission__eyebrow::before {
      width: 20px;
    }

    .rs-mission-{{ section.id }} .rs-mission__quote {
      max-width: 38rem;
    }

    .rs-mission-{{ section.id }} .rs-mission__quote p {
      font-size: clamp(20px, 5.4vw, 24px);
      line-height: 1.7;
    }
  }
{%- endstyle -%}

<div class="rs-mission-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width rs-mission__inner">

    {%- if section.settings.eyebrow_text != blank -%}
      <p class="rs-mission__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading_main != blank or section.settings.heading_script != blank -%}
      <h2 class="rs-mission__heading">
        {%- if section.settings.heading_main != blank -%}
          <span class="rs-mission__heading-main">{{ section.settings.heading_main | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading_script != blank -%}
          <span class="rs-mission__heading-script">{{ section.settings.heading_script | escape }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.quote_text != blank -%}
      <div class="rs-mission__quote">
        {{ section.settings.quote_text }}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Mission \u2014 UBU",
  "tag": "section",
  "class": "rs-mission-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow label",
      "default": "OUR MISSION"
    },
    {
      "type": "select",
      "id": "eyebrow_font",
      "label": "Eyebrow font",
      "options": [
        { "value": "--font-tag-family", "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family", "label": "Alkaline Test" }
      ],
      "default": "--font-tag-family"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#EF4F28"
    },
    {
      "type": "header",
      "content": "Main heading"
    },
    {
      "type": "text",
      "id": "heading_main",
      "label": "Main heading text",
      "default": "UBU \u2014"
    },
    {
      "type": "select",
      "id": "heading_main_font",
      "label": "Main heading font",
      "options": [
        { "value": "--font-tag-family", "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family", "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
    },
    {
      "type": "color",
      "id": "heading_main_color",
      "label": "Main heading color",
      "default": "#262949"
    },
    {
      "type": "header",
      "content": "Script heading"
    },
    {
      "type": "text",
      "id": "heading_script",
      "label": "Script heading text",
      "default": "You Be You."
    },
    {
      "type": "select",
      "id": "heading_script_font",
      "label": "Script heading font",
      "options": [
        { "value": "--font-tag-family", "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family", "label": "Alkaline Test" }
      ],
      "default": "--font-accent-family"
    },
    {
      "type": "color",
      "id": "heading_script_color",
      "label": "Script heading color",
      "default": "#EF4F28"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "richtext",
      "id": "quote_text",
      "label": "Quote text",
      "default": "<p>\u201cWe started Rainbow Smile with a simple belief: when you care for the tiny world inside your mouth, your whole self feels the difference. Your smile isn\u2019t just about teeth \u2014 it\u2019s a living connection to your gut, your immune balance, and your daily well-being. Our mission is to create oral care that treats your body with kindness, from the inside out.\u201d</p>"
    },
    {
      "type": "select",
      "id": "quote_font",
      "label": "Quote font",
      "options": [
        { "value": "--font-tag-family", "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family", "label": "Alkaline Test" }
      ],
      "default": "--font-accent-family"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text color",
      "default": "#262949"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Mission \u2014 UBU"
    }
  ]
}
{% endschema %}
