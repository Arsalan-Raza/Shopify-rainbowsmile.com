{%- style -%}
  #shopify-section-{{ section.id }} {
    --wi-navy:   {{ section.settings.navy_color }};
    --wi-coral:  {{ section.settings.coral_color }};
    --wi-purple: {{ section.settings.purple_color }};
    --wi-gold:   {{ section.settings.gold_color }};
    --wi-sub:    {{ section.settings.sub_color }};
    --wi-body:   {{ section.settings.body_color }};
    --wi-label:  {{ section.settings.label_color }};
    --wi-line:   {{ section.settings.line_color }};
    --wi-cardbg: {{ section.settings.cardbg_color }};
    --wi-green:  {{ section.settings.green_color }};
    --wi-ink:    {{ section.settings.ink_color }};
    --wi-card:   {{ section.settings.card_color }};

    background: {{ section.settings.bg_color }};
    padding-block: clamp(44px, 6vw, 80px);
    padding-inline: clamp(20px, 5vw, 48px);
  }

  .wi-{{ section.id }} * { box-sizing: border-box; }
  .wi-{{ section.id }} { max-width: 1320px; margin-inline: auto; }

  /* ── Header ─────────────────────────────────────────────────── */
  .wi-{{ section.id }} .wi__head {
    text-align: center;
    margin-bottom: clamp(34px, 5vw, 56px);
  }
  .wi-{{ section.id }} .wi__eyebrow {
    margin: 0 0 clamp(16px, 2.4vw, 22px);
    font-family: var(--font-tag-family);
    font-weight: 700;
    font-size: clamp(16px, 1.1vw, 17px);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--wi-coral);
    line-height: 1;
  }
  .wi-{{ section.id }} .wi__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: clamp(38px, 5.6vw, 72px);
    line-height: 1.02;
    letter-spacing: -1px;
    color: var(--wi-navy);
  }
  .wi-{{ section.id }} .wi__script {
    display: block;
    margin-top: 4px;
    font-family: var(--font-accent-family);
    font-weight: 400;
    font-size: clamp(32px, 4.8vw, 60px);
    line-height: 1.12;
    color: var(--wi-coral);
  }
  .wi-{{ section.id }} .wi__sub {
    margin: clamp(16px, 2.4vw, 24px) auto 0;
    max-width: 720px;
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.6;
    color: var(--wi-sub);
  }

  /* ── Three-column grid ──────────────────────────────────────── */
  .wi-{{ section.id }} .wi__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr 1.1fr;
    gap: clamp(24px, 3vw, 44px);
    align-items: start;
  }
  .wi-{{ section.id }} .wi__col-label {
    margin: 0 0 clamp(18px, 2.4vw, 24px);
    font-family: var(--font-tag-family);
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wi-label);
    line-height: 1;
  }

  /* ── Column 1 — ingredient list ─────────────────────────────── */
  .wi-{{ section.id }} .wi__ing { list-style: none; margin: 0; padding: 0; }
  .wi-{{ section.id }} .wi__ing li {
    display: flex;
    gap: 14px;
    margin-bottom: clamp(20px, 2.6vw, 28px);
  }
  .wi-{{ section.id }} .wi__ing li:last-child { margin-bottom: 0; }
  .wi-{{ section.id }} .wi__ing li::before {
    content: "";
    width: 9px;
    height: 9px;
    flex: none;
    margin-top: 9px;
    border-radius: 50%;
    background: var(--wi-coral);
  }
  .wi-{{ section.id }} .wi__ing li.has-icon::before { display: none; }
  .wi-{{ section.id }} .wi__ing-icon {
    width: 36px;
    height: 36px;
    flex: none;
    object-fit: contain;
    margin-top: 3px;
  }
  .wi-{{ section.id }} .wi__ing-title {
    margin: 0 0 5px;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.3;
    color: var(--wi-navy);
  }
  .wi-{{ section.id }} .wi__ing-desc {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(16px, 1.2vw, 17px);
    line-height: 1.55;
    color: var(--wi-body);
  }

  /* ── Column 2 — four pillars card ───────────────────────────── */
  .wi-{{ section.id }} .wi__pillars {
    background: var(--wi-cardbg);
    border: 1px solid var(--wi-line);
    border-radius: 18px;
    padding: clamp(24px, 3vw, 38px);
  }
  .wi-{{ section.id }} .wi__pillars-label {
    margin: 0 0 clamp(20px, 2.6vw, 28px);
    font-family: var(--font-tag-family);
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wi-label);
    line-height: 1;
  }
  .wi-{{ section.id }} .wi__pillar {
    display: grid;
    grid-template-columns: clamp(30px, 3vw, 40px) 1fr;
    gap: 14px;
    padding-block: clamp(14px, 1.8vw, 18px);
    border-top: 1px solid var(--wi-line);
  }
  .wi-{{ section.id }} .wi__pillars .wi__pillar:first-child { border-top: none; padding-top: 0; }
  .wi-{{ section.id }} .wi__pillars .wi__pillar:last-child { padding-bottom: 0; }
  .wi-{{ section.id }} .wi__roman {
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-style: italic;
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.3;
  }
  .wi-{{ section.id }} .wi__pillar-title {
    margin: 0 0 4px;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.3;
    color: var(--wi-navy);
  }
  .wi-{{ section.id }} .wi__pillar-sub {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(16px, 1.2vw, 17px);
    line-height: 1.4;
    color: var(--wi-body);
  }

  /* ── Column 3 — supplement facts ────────────────────────────── */
  .wi-{{ section.id }} .wi__sf {
    border: 1.5px solid var(--wi-ink);
    border-radius: 14px;
    padding: clamp(18px, 2.2vw, 26px);
    background: var(--wi-card);
    font-family: var(--font-heading-family);
    color: var(--wi-ink);
  }
  .wi-{{ section.id }} .wi__sf-title {
    margin: 0 0 clamp(8px, 1.2vw, 12px);
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    letter-spacing: -0.5px;
  }
  .wi-{{ section.id }} .wi__sf-line {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
    padding-block: 7px;
    margin: 0;
  }
  .wi-{{ section.id }} .wi__sf-line strong { font-weight: 700; }
  .wi-{{ section.id }} .wi__bar { border: none; border-top: 8px solid var(--wi-ink); margin: 0; }
  .wi-{{ section.id }} .wi__bar--mid { border-top-width: 5px; }
  .wi-{{ section.id }} .wi__bar--thin { border-top-width: 1px; }
  .wi-{{ section.id }} .wi__sf-amount {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-block: 7px 5px;
  }
  .wi-{{ section.id }} .wi__sf-amount-label { font-weight: 700; font-size: 16px; }
  .wi-{{ section.id }} .wi__sf-cal { font-weight: 700; font-size: clamp(20px, 2vw, 26px); }
  .wi-{{ section.id }} .wi__sf-cal-num {
    font-weight: 800;
    font-size: clamp(34px, 3.6vw, 46px);
    line-height: 1;
  }
  .wi-{{ section.id }} .wi__sf-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 14px;
    align-items: baseline;
    padding-block: 9px;
    border-top: 1px solid var(--wi-ink);
    font-size: 16px;
  }
  .wi-{{ section.id }} .wi__sf-row .name { font-weight: 700; }
  .wi-{{ section.id }} .wi__sf-row .pct { min-width: 44px; text-align: right; font-weight: 700; }
  .wi-{{ section.id }} .wi__sf-oth {
    padding-top: 12px;
    border-top: 5px solid var(--wi-ink);
  }
  .wi-{{ section.id }} .wi__sf-oth-head { margin: 0 0 6px; font-weight: 700; font-size: 16px; }
  .wi-{{ section.id }} .wi__sf-oth-body { margin: 0; font-size: 16px; line-height: 1.5; }
  .wi-{{ section.id }} .wi__sf-note {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--wi-ink);
    font-size: 16px;
    line-height: 1.5;
  }

  /* ── Badges ──────────────────────────────────────────────────── */
  .wi-{{ section.id }} .wi__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(10px, 1.4vw, 16px);
    margin-top: clamp(34px, 5vw, 56px);
    padding: 0;
    list-style: none;
  }
  .wi-{{ section.id }} .wi__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border: 1px solid var(--wi-line);
    border-radius: 999px;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 16px;
    color: var(--wi-navy);
    white-space: nowrap;
  }
  .wi-{{ section.id }} .wi__badge svg {
    width: 15px;
    height: 15px;
    flex: none;
    stroke: var(--wi-green);
    stroke-width: 2.6;
    fill: none;
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 1040px) {
    .wi-{{ section.id }} .wi__grid { grid-template-columns: 1fr 1fr; }
    .wi-{{ section.id }} .wi__sf-col { grid-column: 1 / -1; }
  }
  @media (max-width: 680px) {
    .wi-{{ section.id }} .wi__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="wi-{{ section.id }}">

  {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
    <header class="wi__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wi__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="wi__title">
        {{- section.settings.title | escape -}}
        {%- if section.settings.script != blank -%}
          <span class="wi__script">{{ section.settings.script | escape }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="wi__sub">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="wi__grid">

    <!-- Column 1: Ingredients -->
    <div class="wi__ing-col">
      {%- if section.settings.ing_label != blank -%}
        <p class="wi__col-label">{{ section.settings.ing_label | escape }}</p>
      {%- endif -%}
      {%- assign has_ingredients = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'ingredient' -%}{%- assign has_ingredients = true -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_ingredients -%}
        <ul class="wi__ing">
          {%- for block in section.blocks -%}
            {%- if block.type == 'ingredient' -%}
              <li{% if block.settings.icon_image != blank %} class="has-icon"{% endif %} {{ block.shopify_attributes }}>
                {%- if block.settings.icon_image != blank -%}
                  {%- assign wi_icon_alt = block.settings.icon_image.alt | escape -%}
                  {{- block.settings.icon_image | image_url: width: 72 | image_tag: loading: 'lazy', alt: wi_icon_alt, class: 'wi__ing-icon' -}}
                {%- endif -%}
                <div>
                  {%- if block.settings.name != blank -%}
                    <p class="wi__ing-title">{{ block.settings.name | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.desc != blank -%}
                    <p class="wi__ing-desc">{{ block.settings.desc | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <!-- Column 2: Four Pillars -->
    <div class="wi__pillars-col">
      <div class="wi__pillars">
        {%- if section.settings.pillars_label != blank -%}
          <p class="wi__pillars-label">{{ section.settings.pillars_label | escape }}</p>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'pillar' -%}
            <div class="wi__pillar" {{ block.shopify_attributes }}>
              <span class="wi__roman" style="color: {{ block.settings.roman_color }}">
                {{- block.settings.roman | escape -}}
              </span>
              <div>
                {%- if block.settings.title != blank -%}
                  <p class="wi__pillar-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.sub != blank -%}
                  <p class="wi__pillar-sub">{{ block.settings.sub | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Column 3: Supplement Facts -->
    <div class="wi__sf-col">
      {%- if section.settings.sf_label != blank -%}
        <p class="wi__col-label">{{ section.settings.sf_label | escape }}</p>
      {%- endif -%}
      <div class="wi__sf">
        <p class="wi__sf-title">{{ section.settings.sf_title | escape }}</p>
        <p class="wi__sf-line">{{ section.settings.sf_serving_size | escape }}</p>
        <hr class="wi__bar">
        <p class="wi__sf-line">{{ section.settings.sf_servings | escape }}</p>
        <hr class="wi__bar wi__bar--mid">

        <div class="wi__sf-amount">
          <div>
            <span class="wi__sf-amount-label">Amount Per Serving</span><br>
            <span class="wi__sf-cal">Calories</span>
          </div>
          <span class="wi__sf-cal-num">{{ section.settings.sf_calories | escape }}</span>
        </div>

        <hr class="wi__bar wi__bar--thin">
        <p class="wi__sf-line">% Daily Value*</p>
        <hr class="wi__bar">

        {%- for block in section.blocks -%}
          {%- if block.type == 'sf_row' -%}
            <div class="wi__sf-row" {{ block.shopify_attributes }}>
              <span class="name">{{ block.settings.name | escape }}</span>
              <span>{{ block.settings.amount | escape }}</span>
              <span class="pct">{{ block.settings.pct | escape }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.sf_other_ingredients != blank -%}
          <div class="wi__sf-oth">
            <p class="wi__sf-oth-head">Other Ingredients:</p>
            <p class="wi__sf-oth-body">{{ section.settings.sf_other_ingredients | escape }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.sf_note_1 != blank -%}
          <p class="wi__sf-note">{{ section.settings.sf_note_1 | escape }}</p>
        {%- endif -%}
        {%- if section.settings.sf_note_2 != blank -%}
          <p class="wi__sf-note">{{ section.settings.sf_note_2 | escape }}</p>
        {%- endif -%}
      </div>
    </div>

  </div>

  <!-- Badges -->
  {%- assign has_badges = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'badge' -%}{%- assign has_badges = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if has_badges -%}
    <ul class="wi__badges">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <li class="wi__badge" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.5"/></svg>
            {{- block.settings.text | escape -}}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}

</div>

{% schema %}
