{%- style -%}
  #shopify-section-{{ section.id }} {
    --kh-bg:      {{ section.settings.bg_color }};
    --kh-cream:   {{ section.settings.cream_color }};
    --kh-coral:   {{ section.settings.coral_color }};
    --kh-white:   {{ section.settings.white_color }};
    --kh-body:    {{ section.settings.body_color }};
    --kh-caption: {{ section.settings.caption_color }};
    --kh-border:  rgba(255, 255, 255, 0.28);
  }
  {%- if section.settings.bg_image != blank -%}
    #shopify-section-{{ section.id }} .khero {
      background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
    }
  {%- endif -%}
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} .khero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--kh-bg);
    padding-block: clamp(44px, 6vw, 84px);
    padding-inline: clamp(20px, 4vw, 48px);
  }

  #shopify-section-{{ section.id }} .khero * { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .khero__inner {
    position: relative;
    z-index: 2;
    max-width: 1320px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .khero__content { max-width: 560px; }

  #shopify-section-{{ section.id }} .khero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 clamp(18px, 2.6vw, 26px);
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 400;
    font-size: clamp(14px, 1.1vw, 15px);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--kh-coral);
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .khero__eyebrow::before {
    content: "";
    width: 34px; height: 1.5px;
    background: currentColor;
    flex: none;
  }

  #shopify-section-{{ section.id }} .khero__title {
    margin: 0;
    font-family: var(--font-{{ section.settings.display_font }}-family);
    font-weight: 800;
    font-size: clamp(36px, 4.5vw, 56px);
    line-height: 1.0;
    letter-spacing: -1px;
    color: var(--kh-cream);
  }

  #shopify-section-{{ section.id }} .khero__title-accent {
    display: block;
    font-style: italic;
    color: var(--kh-coral);
  }

  #shopify-section-{{ section.id }} .khero__body {
    margin: clamp(26px, 3.6vw, 40px) 0 0;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.75;
    color: var(--kh-body);
  }
  #shopify-section-{{ section.id }} .khero__body + .khero__body { margin-top: clamp(20px, 2.8vw, 30px); }
  #shopify-section-{{ section.id }} .khero__body p { margin: 0; }
  #shopify-section-{{ section.id }} .khero__body strong { color: var(--kh-white); font-weight: 400; }
  #shopify-section-{{ section.id }} .khero__body sup { font-size: 0.62em; vertical-align: super; }

  #shopify-section-{{ section.id }} .khero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(28px, 4vw, 42px);
  }

  #shopify-section-{{ section.id }} .khero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 18px 34px;
    min-height: 58px;
    border-radius: 999px;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 700;
    font-size: clamp(16px, 1.3vw, 17px);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
  }
  #shopify-section-{{ section.id }} .khero__btn span { transition: transform 0.18s ease; }
  #shopify-section-{{ section.id }} .khero__btn:hover span { transform: translateX(3px); }

  #shopify-section-{{ section.id }} .khero__btn--solid { background: var(--kh-coral); color: #fff; }
  #shopify-section-{{ section.id }} .khero__btn--solid:hover { background: #dc411b; transform: translateY(-2px); }

  #shopify-section-{{ section.id }} .khero__btn--outline {
    background: transparent;
    color: var(--kh-cream);
    border-color: var(--kh-border);
  }
  #shopify-section-{{ section.id }} .khero__btn--outline:hover { background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.5); }
  #shopify-section-{{ section.id }} .khero__btn:focus-visible { outline: 3px solid rgba(239,74,34,0.5); outline-offset: 3px; }

  /* Image */
  #shopify-section-{{ section.id }} .khero__media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: linear-gradient(160deg, #8a5a34, #c08b5c);
  }
  #shopify-section-{{ section.id }} .khero__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .khero__media svg {
    width: 100%; height: 100%;
    display: block;
  }
  #shopify-section-{{ section.id }} .khero__media::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 34%;
    background: linear-gradient(transparent, rgba(20, 10, 4, 0.72));
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .khero__caption {
    position: absolute;
    left: clamp(16px, 2.4vw, 28px);
    right: clamp(16px, 2.4vw, 28px);
    bottom: clamp(14px, 2.2vw, 22px);
    z-index: 2;
    margin: 0;
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 400;
    font-size: clamp(14px, 1.1vw, 15px);
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--kh-caption);
  }

  /* Responsive */
  @media (max-width: 899px) {
    #shopify-section-{{ section.id }} .khero__inner { grid-template-columns: 1fr; gap: clamp(30px, 6vw, 44px); }
    #shopify-section-{{ section.id }} .khero__media { order: -1; aspect-ratio: 4 / 3; }
    #shopify-section-{{ section.id }} .khero__content { max-width: 640px; }
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .khero__actions .khero__btn { width: 100%; }
    #shopify-section-{{ section.id }} .khero__title { letter-spacing: -0.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .khero__btn:hover { transform: none; }
  }
</style>

<div class="khero">
  <div class="khero__inner">

    <!-- LEFT: content -->
    <div class="khero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="khero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank or section.settings.title_accent != blank -%}
        <h1 class="khero__title">
          {{- section.settings.title | escape -}}
          {%- if section.settings.title_accent != blank -%}
            <span class="khero__title-accent">{{ section.settings.title_accent | escape }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.body_1 != blank -%}
        <div class="khero__body">{{ section.settings.body_1 }}</div>
      {%- endif -%}

      {%- if section.settings.body_2 != blank -%}
        <div class="khero__body">{{ section.settings.body_2 }}</div>
      {%- endif -%}

      {%- if section.settings.btn1_text != blank or section.settings.btn2_text != blank -%}
        <div class="khero__actions">
          {%- if section.settings.btn1_text != blank -%}
            <a class="khero__btn khero__btn--solid" href="{{ section.settings.btn1_url | default: '#' }}">
              {{ section.settings.btn1_text | escape }} <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.btn2_text != blank -%}
            <a class="khero__btn khero__btn--outline" href="{{ section.settings.btn2_url | default: '#' }}">
              {{ section.settings.btn2_text | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- RIGHT: image -->
    <div class="khero__media">
      {%- if section.settings.image != blank -%}
        {%- assign img_alt = section.settings.image_alt | default: section.settings.caption -%}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1000 }} 1000w"
          sizes="(max-width: 899px) 100vw, 50vw"
          alt="{{ img_alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <p class="khero__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Kenya Hero",
  "tag": "section",
  "class": "kenya-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rainbow Smile \u00b7 Springboard Connectivity \u00b7 Kenya"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Headline — main line (cream)",
      "default": "The Invisible"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Headline — accent line (coral, italic)",
      "default": "Crisis."
    },
    {
      "type": "richtext",
      "id": "body_1",
      "label": "Body paragraph 1",
      "default": "<p>3.5 billion people live with oral disease. In Kenya, the number is not a majority. <strong>It is everyone.<\/strong><\/p>"
    },
    {
      "type": "richtext",
      "id": "body_2",
      "label": "Body paragraph 2",
      "default": "<p>We are Rainbow Smile \u2014 a small startup with a revolutionary oral wellness product and a mission that reaches further than any product can alone. We are committed to getting OG3\u2122 into the hands of people who need it most. One village at a time.<\/p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary button text",
      "default": "Donate to the Cause"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary button text",
      "default": "Read the Full Story"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "info": "Covers the full section behind the content. Falls back to the background color if blank."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (right column)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Leave blank to use the caption text"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "Tracy Tarlow \u00b7 Executive Director, Springboard Connectivity \u00b7 Kenya"
    },
    {
      "type": "header",
      "content": "Fonts"
    },
    {
      "type": "select",
      "id": "display_font",
      "label": "Headline font",
      "info": "The design uses a bold serif. Use Alkaline Test or swap in a custom display font.",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "accent"
    },
    {
      "type": "select",
      "id": "mono_font",
      "label": "Eyebrow & caption font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "tag"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Button font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body text font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#1c1109"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Headline color",
      "default": "#ece2d4"
    },
    {
      "type": "color",
      "id": "coral_color",
      "label": "Accent color (eyebrow, accent line, button)",
      "default": "#ef4a22"
    },
    {
      "type": "color",
      "id": "white_color",
      "label": "Emphasis text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#a2978c"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Image caption color",
      "default": "#efe6da"
    }
  ],
  "presets": [
    {
      "name": "Kenya Hero"
    }
  ]
}
{% endschema %}
