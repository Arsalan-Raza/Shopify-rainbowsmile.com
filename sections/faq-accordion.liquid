{%- style -%}
  /* ── Section wrapper ───────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    --faq-bg:     {{ section.settings.bg_color }};
    --faq-navy:   {{ section.settings.heading_color }};
    --faq-body:   {{ section.settings.body_color }};
    --faq-accent: {{ section.settings.accent_color }};
    --faq-peach:  {{ section.settings.icon_bg_color }};
    --faq-gold:   {{ section.settings.cta_color }};
    --faq-line:   {{ section.settings.divider_color }};

    background: var(--faq-bg);
    padding-top:    {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-inline: clamp(20px, 5vw, 40px);
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top:    {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Inner ─────────────────────────────────────────────────── */
  .faq-{{ section.id }} * { box-sizing: border-box; }

  .faq-{{ section.id }} .faq__inner {
    max-width: 720px;
    margin-inline: auto;
  }

  /* ── Header ────────────────────────────────────────────────── */
  .faq-{{ section.id }} .faq__head {
    text-align: center;
    margin-bottom: clamp(40px, 7vw, 72px);
  }

  .faq-{{ section.id }} .faq__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-family: var({{ section.settings.eyebrow_font }});
    font-weight: 700;
    font-size: clamp(12px, 1.2vw, 13px);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--faq-accent);
    line-height: 1;
  }
  .faq-{{ section.id }} .faq__eyebrow::before {
    content: "";
    width: 26px;
    height: 2px;
    background: currentColor;
    flex: none;
  }

  .faq-{{ section.id }} .faq__title {
    margin: 0;
    font-family: var({{ section.settings.heading_font }});
    font-weight: 700;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.5px;
    color: var(--faq-navy);
  }

  .faq-{{ section.id }} .faq__script {
    display: block;
    margin-top: 2px;
    font-family: var({{ section.settings.script_font }});
    font-weight: 400;
    font-size: clamp(32px, 4.4vw, 50px);
    line-height: 1.05;
    color: var(--faq-accent);
  }

  /* ── Accordion ─────────────────────────────────────────────── */
  .faq-{{ section.id }} .faq__item {
    border-bottom: 1px solid var(--faq-line);
  }

  .faq-{{ section.id }} .faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }
  .faq-{{ section.id }} .faq__summary::-webkit-details-marker { display: none; }
  .faq-{{ section.id }} .faq__summary:focus-visible {
    outline: 3px solid rgba(244,80,43,0.35);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .faq-{{ section.id }} .faq__q {
    font-family: var({{ section.settings.question_font }});
    font-weight: 700;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.3;
    color: var(--faq-navy);
  }

  /* + / − icon */
  .faq-{{ section.id }} .faq__icon {
    position: relative;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    background: var(--faq-peach);
  }
  .faq-{{ section.id }} .faq__icon::before,
  .faq-{{ section.id }} .faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--faq-accent);
    transform: translate(-50%, -50%);
  }
  .faq-{{ section.id }} .faq__icon::before { width: 13px; height: 2px; }
  .faq-{{ section.id }} .faq__icon::after {
    width: 2px;
    height: 13px;
    transition: transform 0.2s ease;
  }
  .faq-{{ section.id }} .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) scaleY(0);
  }

  /* Answer */
  .faq-{{ section.id }} .faq__answer {
    padding: 0 0 24px;
    max-width: 62ch;
  }
  .faq-{{ section.id }} .faq__answer p {
    margin: 0;
    font-family: var({{ section.settings.answer_font }});
    font-weight: 400;
    font-size: clamp(15px, 1.3vw, 16px);
    line-height: 1.65;
    color: var(--faq-body);
  }
  .faq-{{ section.id }} .faq__answer p + p {
    margin-top: 14px;
  }
  .faq-{{ section.id }} .faq__item[open] .faq__answer {
    animation: faqOpen-{{ section.id }} 0.25s ease;
  }
  @keyframes faqOpen-{{ section.id }} {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }

  /* ── CTA ───────────────────────────────────────────────────── */
  .faq-{{ section.id }} .faq__cta-wrap {
    text-align: center;
    margin-top: clamp(40px, 6vw, 64px);
  }
  .faq-{{ section.id }} .faq__cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 32px;
    border-radius: 999px;
    background: var(--faq-gold);
    color: var(--faq-navy);
    font-family: var({{ section.settings.cta_font }});
    font-weight: 400;
    font-size: clamp(15px, 1.4vw, 15px);
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .faq-{{ section.id }} .faq__cta span { transition: transform 0.18s ease; }
  .faq-{{ section.id }} .faq__cta:hover { background: #ecb02f; }
  .faq-{{ section.id }} .faq__cta:hover span { transform: translateX(3px); }
  .faq-{{ section.id }} .faq__cta:focus-visible {
    outline: 3px solid rgba(243,189,66,0.5);
    outline-offset: 3px;
  }

  /* ── Mobile ────────────────────────────────────────────────── */
  @media screen and (max-width: 480px) {
    .faq-{{ section.id }} .faq__icon { width: 32px; height: 32px; }
    .faq-{{ section.id }} .faq__cta { width: 100%; justify-content: center; }
  }
{%- endstyle -%}

<div class="faq-{{ section.id }}">
  <div class="faq__inner">

    {%- comment -%} ── Header ── {%- endcomment -%}
    {%- if section.settings.eyebrow_text != blank
        or section.settings.heading_text != blank
        or section.settings.script_text != blank -%}
      <header class="faq__head">
        {%- if section.settings.eyebrow_text != blank -%}
          <p class="faq__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading_text != blank or section.settings.script_text != blank -%}
          <h2 class="faq__title">
            {{ section.settings.heading_text | escape }}
            {%- if section.settings.script_text != blank -%}
              <span class="faq__script">{{ section.settings.script_text | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%} ── Accordion ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="faq__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            <details class="faq__item" {{ block.shopify_attributes }}>
              <summary class="faq__summary">
                <span class="faq__q">{{ block.settings.question | escape }}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              {%- if block.settings.answer != blank -%}
                <div class="faq__answer">{{ block.settings.answer }}</div>
              {%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── CTA ── {%- endcomment -%}
    {%- if section.settings.cta_label != blank -%}
      <div class="faq__cta-wrap">
        <a class="faq__cta" href="{{ section.settings.cta_url }}">
          {{ section.settings.cta_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
