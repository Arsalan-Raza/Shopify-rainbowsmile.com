{%- style -%}
  #shopify-section-{{ section.id }} {
    --sg-coral:    {{ section.settings.card_color }};
    --sg-gold:     {{ section.settings.script_color }};
    --sg-curve:    {{ section.settings.curve_color }};
    --sg-overhang: clamp(28px, 4vw, 44px);

    background: {{ section.settings.bg_color }};
    padding-bottom: var(--sg-overhang);
    margin-bottom: 50px ;
  }

  .signal-{{ section.id }} * { box-sizing: border-box; }

  /* ── Media ──────────────────────────────────────────────────── */
  .signal-{{ section.id }} .sg__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: linear-gradient(170deg, #f4ecdc, #faf6ee);
    overflow: visible;
  }
  .signal-{{ section.id }} .sg__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Bottom curve ───────────────────────────────────────────── */
  .signal-{{ section.id }} .sg__curve {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: clamp(30px, 4.5vw, 52px);
    z-index: 2;
    pointer-events: none;
  }
  .signal-{{ section.id }} .sg__curve svg { width: 100%; height: 100%; display: block; }

  /* ── Overlapping card ───────────────────────────────────────── */
  .signal-{{ section.id }} .sg__card {
    position: absolute;
    left: 50%;
    bottom: calc(var(--sg-overhang) * -1);
    transform: translateX(-50%);
    z-index: 3;
    width: min(560px, calc(100% - clamp(32px, 8vw, 80px)));
    background: var(--sg-coral);
    border-radius: 12px;
    padding: clamp(20px, 2.6vw, 30px) clamp(20px, 3vw, 40px);
    text-align: center;
  }

  .signal-{{ section.id }} .sg__title {
    margin: 0;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 800;
    font-size: clamp(27px, 3.2vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: #ffffff;
  }
  .signal-{{ section.id }} .sg__script {
    display: block;
    margin-top: 2px;
    font-family: var(--font-{{ section.settings.script_font }}-family);
    font-weight: 400;
    font-size: clamp(32px, 2.8vw, 36px);
    line-height: 1.15;
    color: var(--sg-gold);
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media screen and (max-width: 899px) {
    .signal-{{ section.id }} .sg__media { aspect-ratio: 4 / 3; }
  }
  @media screen and (max-width: 560px) {
    .signal-{{ section.id }} .sg__media { aspect-ratio: 1 / 1; }
    .signal-{{ section.id }} .sg__card { padding: 18px 20px; border-radius: 7px; }
  }
{%- endstyle -%}

<div class="signal-{{ section.id }}">
  <div class="sg__media">

    {%- if section.settings.image != blank -%}
      {%- assign img_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          alt: img_alt,
          widths: '750, 1100, 1500, 2000'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}

    {%- if section.settings.show_curve -%}
      <div class="sg__curve" aria-hidden="true">
        <svg viewBox="0 0 1440 48" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,48 L1440,48 L1440,40 Q720,-24 0,40 Z" fill="{{ section.settings.curve_color }}"/>
        </svg>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.script_line != blank -%}
      <div class="sg__card">
        <h2 class="sg__title">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.script_line != blank -%}
            <span class="sg__script">{{ section.settings.script_line | escape }}</span>
          {%- endif -%}
        </h2>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Signal Banner",
  "tag": "section",
  "class": "signal-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "header",
      "content": "Card text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bad Breath Isn't Normal"
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script line",
      "default": "It's a Signal."
    },
    {
      "type": "header",
      "content": "Bottom curve"
    },
    {
      "type": "checkbox",
      "id": "show_curve",
      "label": "Show bottom curve",
      "default": true
    },
    {
      "type": "color",
      "id": "curve_color",
      "label": "Curve color (match section below)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Fonts"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "script_font",
      "label": "Script line font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "accent"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ef4a22"
    },
    {
      "type": "color",
      "id": "script_color",
      "label": "Script line color",
      "default": "#f7c85f"
    }
  ],
  "presets": [
    {
      "name": "Signal Banner"
    }
  ]
}
{% endschema %}
