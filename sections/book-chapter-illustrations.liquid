{%- style -%}
  #shopify-section-{{ section.id }} {
    --cg-navy:  {{ section.settings.navy_color }};
    --cg-coral: {{ section.settings.coral_color }};
    --cg-sub:   {{ section.settings.sub_color }};
    --cg-meta:  {{ section.settings.meta_color }};
    --cg-line:  {{ section.settings.line_color }};
    --cg-plate: {{ section.settings.plate_color }};
  }
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} .chg {
    background: {{ section.settings.bg_color }};
    padding-block: clamp(44px, 6vw, 84px);
    padding-inline: clamp(16px, 4vw, 48px);
  }

  #shopify-section-{{ section.id }} .chg * { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .chg__inner { max-width: 1240px; margin-inline: auto; }

  /* ---------- Header ---------- */
  #shopify-section-{{ section.id }} .chg__head { text-align: center; margin-bottom: clamp(34px, 5vw, 60px); }

  #shopify-section-{{ section.id }} .chg__eyebrow {
    margin: 0 0 clamp(14px, 2vw, 20px);
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 400;
    font-size: clamp(12px, 1.1vw, 13px);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--cg-coral);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .chg__title {
    margin: 0;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 800;
    font-size: clamp(30px, 4.2vw, 50px);
    line-height: 1.12;
    letter-spacing: -0.5px;
    color: var(--cg-navy);
  }

  #shopify-section-{{ section.id }} .chg__script {
    display: block;
    margin-top: 2px;
    font-family: var(--font-{{ section.settings.script_font }}-family);
    font-weight: 400;
    font-size: clamp(28px, 3.8vw, 46px);
    line-height: 1.15;
    color: var(--cg-coral);
  }

  #shopify-section-{{ section.id }} .chg__sub {
    margin: clamp(12px, 1.8vw, 18px) auto 0;
    max-width: 520px;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.6;
    color: var(--cg-sub);
  }

  /* ---------- Grid ---------- */
  #shopify-section-{{ section.id }} .chg__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2.4vw, 34px) clamp(14px, 1.8vw, 24px);
  }

  #shopify-section-{{ section.id }} .chg__item { margin: 0; }

  #shopify-section-{{ section.id }} .chg__plate {
    display: block;
    border: 1px solid var(--cg-line);
    border-radius: 3px;
    overflow: hidden;
    background: var(--cg-plate);
    aspect-ratio: 3 / 4;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .chg__plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .chg__plate svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} a.chg__plate:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(40, 35, 30, 0.14);
    border-color: #d6d6de;
  }
  #shopify-section-{{ section.id }} a.chg__plate:focus-visible {
    outline: 3px solid rgba(239,74,34,0.4);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .chg__caption {
    margin: 12px 0 0;
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--cg-meta);
  }

  #shopify-section-{{ section.id }} .chg__ch { color: var(--cg-coral); }

  /* Responsive */
  @media (max-width: 979px) {
    #shopify-section-{{ section.id }} .chg__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 680px) {
    #shopify-section-{{ section.id }} .chg__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} a.chg__plate:hover { transform: none; }
  }
</style>

<div class="chg">
  <div class="chg__inner">

    <header class="chg__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="chg__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank or section.settings.script_line != blank -%}
        <h2 class="chg__title">
          {{ section.settings.title | escape | newline_to_br }}
          {%- if section.settings.script_line != blank -%}
            <span class="chg__script">{{ section.settings.script_line | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="chg__sub">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="chg__grid">
        {%- for block in section.blocks -%}
          <figure class="chg__item" {{ block.shopify_attributes }}>

            {%- if block.settings.link != blank -%}
              <a class="chg__plate" href="{{ block.settings.link }}">
            {%- else -%}
              <div class="chg__plate">
            {%- endif -%}

              {%- if block.settings.image != blank -%}
                {%- assign plate_alt = block.settings.alt | default: block.settings.chapter_label -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  srcset="{{ block.settings.image | image_url: width: 300 }} 300w, {{ block.settings.image | image_url: width: 450 }} 450w, {{ block.settings.image | image_url: width: 600 }} 600w"
                  sizes="(max-width: 679px) calc(50vw - 24px), (max-width: 979px) calc(33vw - 20px), calc(25vw - 22px)"
                  alt="{{ plate_alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}

            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}

            {%- if block.settings.chapter_label != blank or block.settings.page_label != blank -%}
              <figcaption class="chg__caption">
                {%- if block.settings.chapter_label != blank -%}
                  <span class="chg__ch">{{ block.settings.chapter_label | escape }}</span>
                {%- endif -%}
                {%- if block.settings.page_label != blank -%}
                  {%- if block.settings.chapter_label != blank -%} &middot; {%- endif -%}
                  {{ block.settings.page_label | escape }}
                {%- endif -%}
              </figcaption>
            {%- endif -%}

          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Book Illustrations",
  "tag": "section",
  "class": "book-chapter-illustrations-section",
  "blocks": [
    {
      "type": "illustration",
      "name": "Illustration",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Illustration image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text",
          "info": "Leave blank to use the chapter label"
        },
        {
          "type": "text",
          "id": "chapter_label",
          "label": "Chapter label",
          "info": "e.g. CH.1",
          "default": "CH.1"
        },
        {
          "type": "text",
          "id": "page_label",
          "label": "Page label",
          "info": "e.g. P.13",
          "default": "P.13"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "Leave blank to render as a non-interactive plate"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "12 Chapter Illustrations"
    },
    {
      "type": "text",
      "id": "title",
