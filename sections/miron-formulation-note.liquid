      "default": "If you are pregnant, nursing, taking prescription medication, or have a diagnosed health condition, consult your healthcare provider before use. Keep out of reach of children under 2 years of age. Store in a cool, dry place away from direct sunlight."
    },
    {
      "type": "color",
      "id": "fda_bg",
      "label": "Block background",
      "default": "#fbf4ee"
    },
    {
      "type": "color",
      "id": "fda_label_color",
      "label": "Label color",
      "default": "#6b5f52"
    },
    {
      "type": "color",
      "id": "fda_body_color",
      "label": "Body color",
      "default": "#6b5f52"
    },
    {
      "type": "header",
      "content": "Accent Colors"
    },
    {
      "type": "color",
      "id": "purple_color",
