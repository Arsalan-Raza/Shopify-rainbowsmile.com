{%- style -%}
  #shopify-section-{{ section.id }} {
    --mg-purple: {{ section.settings.purple_color }};
    --mg-green:  {{ section.settings.green_color }};

    background: {{ section.settings.bg_color }};
    padding-block: clamp(36px, 5vw, 64px);
    padding-inline: clamp(20px, 5vw, 48px);
  }

  .mgf-{{ section.id }} * { box-sizing: border-box; }
  .mgf-{{ section.id }} { max-width: 1240px; margin-inline: auto; }

  /* ── Two cards ───────────────────────────────────────────────── */
  .mgf-{{ section.id }} .mgf__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2vw, 26px);
    margin-bottom: clamp(16px, 2vw, 26px);
    align-items: stretch;
  }
  .mgf-{{ section.id }} .mgf__card {
    border-radius: 16px;
    padding: clamp(26px, 3.2vw, 40px);
  }
  .mgf-{{ section.id }} .mgf__card--rust { background: {{ section.settings.rust_bg }}; }
  .mgf-{{ section.id }} .mgf__card--gold { background: {{ section.settings.gold_bg }}; }

  /* ── Icons ───────────────────────────────────────────────────── */
  .mgf-{{ section.id }} .mgf__icon {
    width: clamp(38px, 4vw, 46px);
    height: clamp(38px, 4vw, 46px);
    display: grid;
    place-items: center;
    margin-bottom: clamp(28px, 3.6vw, 44px);
  }
  .mgf-{{ section.id }} .mgf__dot {
    width: clamp(28px, 3vw, 34px);
    height: clamp(28px, 3vw, 34px);
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #a45ef0, var(--mg-purple) 70%);
    box-shadow: 0 4px 12px rgba(90, 30, 170, 0.35);
  }
  .mgf-{{ section.id }} .mgf__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--mg-green);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── Eyebrow ─────────────────────────────────────────────────── */
  .mgf-{{ section.id }} .mgf__eyebrow {
    margin: 0 0 clamp(12px, 1.8vw, 16px);
    font-family: var(--font-tag-family);
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    line-height: 1;
  }
  .mgf-{{ section.id }} .mgf__card--rust .mgf__eyebrow { color: {{ section.settings.rust_eyebrow_color }}; }
  .mgf-{{ section.id }} .mgf__card--gold .mgf__eyebrow { color: {{ section.settings.gold_eyebrow_color }}; }

  /* ── Title ───────────────────────────────────────────────────── */
  .mgf-{{ section.id }} .mgf__title {
    margin: 0 0 clamp(14px, 2vw, 18px);
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.25;
  }
  .mgf-{{ section.id }} .mgf__card--rust .mgf__title { color: {{ section.settings.rust_title_color }}; }
  .mgf-{{ section.id }} .mgf__card--gold .mgf__title { color: {{ section.settings.gold_title_color }}; }

  /* ── Body ────────────────────────────────────────────────────── */
  .mgf-{{ section.id }} .mgf__body {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(16px, 1.25vw, 17px);
    line-height: 1.65;
  }
  .mgf-{{ section.id }} .mgf__body + .mgf__body { margin-top: clamp(16px, 2.2vw, 22px); }
  .mgf-{{ section.id }} .mgf__body sup { font-size: 0.62em; vertical-align: super; }
  .mgf-{{ section.id }} .mgf__card--rust .mgf__body { color: {{ section.settings.rust_body_color }}; }
  .mgf-{{ section.id }} .mgf__card--gold .mgf__body { color: {{ section.settings.gold_body_color }}; }
  .mgf-{{ section.id }} .mgf__card--gold .mgf__body strong {
    font-weight: 700;
    color: {{ section.settings.gold_title_color }};
  }

  /* ── FDA disclosure ──────────────────────────────────────────── */
  .mgf-{{ section.id }} .mgf__fda {
    background: {{ section.settings.fda_bg }};
    border-radius: 16px;
    padding: clamp(28px, 3.6vw, 48px) clamp(24px, 3.2vw, 44px);
  }
  .mgf-{{ section.id }} .mgf__fda-label {
    margin: 0 0 clamp(16px, 2.2vw, 22px);
    font-family: var(--font-tag-family);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: {{ section.settings.fda_label_color }};
    line-height: 1;
  }
  .mgf-{{ section.id }} .mgf__fda-body {
    margin: 0;
    font-family: var(--font-tag-family);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.5;
    text-transform: uppercase;
    color: {{ section.settings.fda_body_color }};
  }
  .mgf-{{ section.id }} .mgf__fda-body + .mgf__fda-body { margin-top: clamp(16px, 2.2vw, 22px); }
  .mgf-{{ section.id }} .mgf__fda-body sup { font-size: 0.7em; vertical-align: super; text-transform: none; }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 760px) {
    .mgf-{{ section.id }} .mgf__cards { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="mgf-{{ section.id }}">

  <div class="mgf__cards">

    <!-- Rust card: Miron Glass -->
    <div class="mgf__card mgf__card--rust">
      <div class="mgf__icon" aria-hidden="true"><span class="mgf__dot"></span></div>
      {%- if section.settings.rust_eyebrow != blank -%}
        <p class="mgf__eyebrow">{{ section.settings.rust_eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.rust_title != blank -%}
        <h2 class="mgf__title">{{ section.settings.rust_title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.rust_body != blank -%}
        <p class="mgf__body">{{ section.settings.rust_body }}</p>
      {%- endif -%}
    </div>

    <!-- Gold card: Formulation Note -->
    <div class="mgf__card mgf__card--gold">
      <div class="mgf__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32">
          <path d="M8 26C14 26 22 22 24 10"/>
          <path d="M24 10c-3.4.3-5.6 1.6-6.6 3.8M24 10c-.3 3.4-1.6 5.6-3.8 6.6M18.5 17c-3 .3-5 1.5-6 3.6M18.5 17c-.3 3-1.5 5-3.6 6"/>
        </svg>
      </div>
      {%- if section.settings.gold_eyebrow != blank -%}
        <p class="mgf__eyebrow">{{ section.settings.gold_eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.gold_title != blank -%}
        <h2 class="mgf__title">{{ section.settings.gold_title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.gold_body_1 != blank -%}
        <p class="mgf__body">{{ section.settings.gold_body_1 }}</p>
      {%- endif -%}
      {%- if section.settings.gold_body_2 != blank -%}
        <p class="mgf__body">{{ section.settings.gold_body_2 }}</p>
      {%- endif -%}
    </div>

  </div>

  <!-- FDA disclosure -->
  <div class="mgf__fda">
    {%- if section.settings.fda_label != blank -%}
      <p class="mgf__fda-label">{{ section.settings.fda_label | escape }}</p>
    {%- endif -%}
    {%- if section.settings.fda_body_1 != blank -%}
      <p class="mgf__fda-body">{{ section.settings.fda_body_1 }}</p>
    {%- endif -%}
    {%- if section.settings.fda_body_2 != blank -%}
      <p class="mgf__fda-body">{{ section.settings.fda_body_2 }}</p>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "Miron & Formulation Note",
  "tag": "section",
  "class": "miron-formulation-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Rust Card — Miron Glass"
    },
    {
      "type": "text",
      "id": "rust_eyebrow",
      "label": "Eyebrow",
      "default": "Caring for Your Bottle"
    },
    {
      "type": "text",
      "id": "rust_title",
      "label": "Title",
      "default": "Miron Violet Glass"
    },
    {
      "type": "textarea",
      "id": "rust_body",
      "label": "Body (HTML allowed: <strong>, <sup>)",
      "default": "Store away from prolonged direct sunlight. The Miron violet glass is actively protecting the formulation — it transmits the beneficial infrared and UV-A spectrum while blocking the visible light that degrades bioactive ingredients. Keep the cap closed when not in use. The bottle is reusable and recyclable."
    },
    {
      "type": "color",
      "id": "rust_bg",
      "label": "Card background",
      "default": "#b0512e"
    },
    {
      "type": "color",
      "id": "rust_eyebrow_color",
      "label": "Eyebrow color",
      "default": "#ffe8d9"
    },
    {
      "type": "color",
      "id": "rust_title_color",
      "label": "Title color",
      "default": "#fdeee4"
    },
    {
      "type": "color",
      "id": "rust_body_color",
      "label": "Body color",
      "default": "#fdeee4"
    },
    {
      "type": "header",
      "content": "Gold Card — Formulation Note"
    },
    {
      "type": "text",
      "id": "gold_eyebrow",
      "label": "Eyebrow",
      "default": "A Note on Our Formulation"
    },
    {
      "type": "text",
      "id": "gold_title",
      "label": "Title",
      "default": "Designed to work with your oral microbiome"
    },
    {
      "type": "textarea",
      "id": "gold_body_1",
      "label": "Body paragraph 1 (HTML allowed: <strong>, <sup>)",
      "default": "OG3\u2122 is designed to work with your oral microbiome, not against it. Every ingredient is certified organic and selected because the body recognises it. The oxygen infusion, EZ water, and biofield frequencies are properties of the formulation process — not additives. <strong>Nothing in any OG3\u2122 product will harm your oral microbiome.</strong>"
    },
    {
      "type": "textarea",
      "id": "gold_body_2",
      "label": "Body paragraph 2",
      "default": "Safe to swallow. If you are pregnant, nursing, or under medical supervision for an oral condition, consult your healthcare provider before use."
    },
    {
      "type": "color",
      "id": "gold_bg",
      "label": "Card background",
      "default": "#f7e7bf"
    },
    {
      "type": "color",
      "id": "gold_eyebrow_color",
      "label": "Eyebrow color",
      "default": "#b79445"
    },
    {
      "type": "color",
      "id": "gold_title_color",
      "label": "Title color",
      "default": "#2a2410"
    },
    {
      "type": "color",
      "id": "gold_body_color",
      "label": "Body color",
      "default": "#4a4636"
    },
    {
      "type": "header",
      "content": "FDA Disclosure"
    },
    {
      "type": "text",
      "id": "fda_label",
      "label": "Label",
      "default": "FDA Disclosure"
    },
    {
      "type": "textarea",
      "id": "fda_body_1",
      "label": "Paragraph 1 (HTML allowed: <sup>)",
      "default": "These statements have not been evaluated by the Food and Drug Administration. OG3\u2122 is not intended to diagnose, treat, cure, or prevent any disease. OG3\u2122 is a dietary supplement. Results may vary between individuals. The information provided on this page is for educational purposes and is not a substitute for professional medical advice, diagnosis, or treatment. Always seek the advice of your physician or other qualified healthcare provider with any questions you may have regarding a medical condition. Do not disregard professional medical advice or delay seeking it because of information you have read here."
    },
    {
      "type": "textarea",
      "id": "fda_body_2",
