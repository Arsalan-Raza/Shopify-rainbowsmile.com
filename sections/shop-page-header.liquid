{%- style -%}
  /* ── Section wrapper ───────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    --ph-coral:  {{ section.settings.bg_color }};
    --ph-gold:   {{ section.settings.script_color }};
    --ph-navy:   {{ section.settings.tm_color }};
    --ph-curve:  {{ section.settings.curve_color }};

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--ph-coral);
    padding: clamp(48px, 6vw, 76px) clamp(20px, 5vw, 40px) clamp(72px, 9vw, 108px);
    text-align: center;
  }

  .ph-{{ section.id }} * { box-sizing: border-box; }

  /* ── Inner ─────────────────────────────────────────────────── */
  .ph-{{ section.id }} .ph__inner {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin-inline: auto;
  }

  /* ── Eyebrow ───────────────────────────────────────────────── */
  .ph-{{ section.id }} .ph__eyebrow {
    margin: 0 0 14px;
    font-family: var({{ section.settings.eyebrow_font }});
    font-weight: 400;
    font-size: clamp(12px, 1.2vw, 13px);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    line-height: 1.5;
  }
  .ph-{{ section.id }} .ph__eyebrow sup { font-size: 0.7em; vertical-align: super; }

  /* ── Title ─────────────────────────────────────────────────── */
  .ph-{{ section.id }} .ph__title {
    margin: 0;
    font-family: var({{ section.settings.heading_font }});
    font-weight: 800;
    font-size: clamp(34px, 4.6vw, 52px);
    line-height: 1.02;
    letter-spacing: -0.5px;
    color: #ffffff;
  }
  .ph-{{ section.id }} .ph__script {
    display: block;
    margin-top: 2px;
    font-family: var({{ section.settings.script_font }});
    font-weight: 400;
    font-size: clamp(34px, 4.6vw, 54px);
    line-height: 1.08;
    color: var(--ph-gold);
  }
  .ph-{{ section.id }} .ph__tm {
    font-family: var({{ section.settings.heading_font }});
    font-weight: 800;
    font-size: 1em;
    color: var(--ph-navy);
    letter-spacing: 0;
  }

  /* ── Subtitle ──────────────────────────────────────────────── */
  .ph-{{ section.id }} .ph__sub {
    margin: clamp(14px, 2vw, 18px) auto 0;
    max-width: 640px;
    font-family: var({{ section.settings.subtitle_font }});
    font-weight: 400;
    font-size: clamp(14px, 1.4vw, 16px);
    line-height: 1.5;
    color: rgba(255,255,255,0.9);
  }

  /* ── Badge pills ───────────────────────────────────────────── */
  .ph-{{ section.id }} .ph__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: clamp(22px, 3vw, 30px);
  }
  .ph-{{ section.id }} .ph__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    min-height: 40px;
    border-radius: 999px;
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.16);
    font-family: var({{ section.settings.badge_font }});
    font-weight: 700;
    font-size: clamp(12px, 1.1vw, 13px);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
  }
  .ph-{{ section.id }} .ph__badge-icon { font-size: 14px; line-height: 1; }

  /* ── Bottom curve ──────────────────────────────────────────── */
  .ph-{{ section.id }} .ph__curve {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: clamp(32px, 4.5vw, 56px);
    z-index: 3;
  }
  .ph-{{ section.id }} .ph__curve svg { width: 100%; height: 100%; display: block; }
  .ph-{{ section.id }} .ph__curve svg path { fill: var(--ph-curve); }

  /* ── Mobile ────────────────────────────────────────────────── */
  @media screen and (max-width: 560px) {
    .ph-{{ section.id }} .ph__eyebrow { letter-spacing: 1.2px; }
    .ph-{{ section.id }} .ph__badges { gap: 10px; }
    .ph-{{ section.id }} .ph__badge { padding: 10px 14px; }
  }
{%- endstyle -%}

<div class="ph-{{ section.id }}">
  <div class="ph__inner">

    {%- if section.settings.eyebrow_text != blank -%}
      <p class="ph__eyebrow">{{ section.settings.eyebrow_text }}</p>
    {%- endif -%}

    {%- if section.settings.heading_text != blank or section.settings.script_text != blank -%}
      <h1 class="ph__title">
        {%- if section.settings.heading_text != blank -%}
          {{ section.settings.heading_text | escape }}
        {%- endif -%}
        {%- if section.settings.script_before != blank or section.settings.script_after != blank -%}
          <span class="ph__script">
            {{- section.settings.script_before | escape -}}
            {%- if section.settings.show_tm -%}<span class="ph__tm">™</span>{%- endif -%}
            {{- section.settings.script_after | escape -}}
          </span>
        {%- endif -%}
      </h1>
    {%- endif -%}

    {%- if section.settings.subtitle_text != blank -%}
      <p class="ph__sub">{{ section.settings.subtitle_text | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ph__badges">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <span class="ph__badge" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="ph__badge-icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
              {{ block.settings.label | escape }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  {%- if section.settings.show_curve -%}
    <div class="ph__curve" aria-hidden="true">
      <svg viewBox="0 0 1440 48" preserveAspectRatio="none">
        <path d="M0,48 L1440,48 L1440,40 Q720,-24 0,40 Z"/>
      </svg>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Shop Page Header",
  "tag": "section",
  "class": "shop-page-header-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "OG3™ Biome Food™ · Holistic Oral Wellness"
    },
    {
      "type": "select",
      "id": "eyebrow_font",
      "label": "Eyebrow font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-tag-family"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Shop All"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
    },
    {
      "type": "header",
      "content": "Script line"
    },
    {
      "type": "text",
      "id": "script_before",
      "label": "Script text — before ™",
      "default": "OG3",
      "info": "This text appears before the ™ mark."
    },
    {
      "type": "checkbox",
      "id": "show_tm",
      "label": "Show ™ mark",
      "default": true
    },
    {
      "type": "text",
      "id": "script_after",
      "label": "Script text — after ™",
      "default": " Drops.",
      "info": "This text appears after the ™ mark."
    },
    {
      "type": "select",
      "id": "script_font",
      "label": "Script font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-accent-family"
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "text",
      "id": "subtitle_text",
      "label": "Subtitle",
      "default": "3 flavors · 2 formats · 6 ways to restore your living mouth"
    },
    {
      "type": "select",
      "id": "subtitle_font",
      "label": "Subtitle font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
    },
    {
      "type": "header",
      "content": "Badge pills"
    },
    {
      "type": "select",
      "id": "badge_font",
      "label": "Badge font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-tag-family"
    },
    {
      "type": "header",
      "content": "Bottom curve"
    },
    {
      "type": "checkbox",
      "id": "show_curve",
      "label": "Show bottom curve",
      "default": true
    },
    {
      "type": "color",
      "id": "curve_color",
      "label": "Curve color",
      "info": "Should match the background of the section below.",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f0512a"
    },
    {
      "type": "color",
      "id": "script_color",
      "label": "Script line color",
      "default": "#f7c85f"
    },
    {
      "type": "color",
      "id": "tm_color",
      "label": "™ mark color",
      "default": "#23324a"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge pill",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🌿",
          "info": "Paste any emoji here."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Badge label",
          "default": "Certified Organic"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Page Header",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🌿", "label": "Certified Organic" } },
        { "type": "badge", "settings": { "icon": "🚀", "label": "Free Shipping $49+" } },
        { "type": "badge", "settings": { "icon": "💎", "label": "Miron Violet Glass" } },
        { "type": "badge", "settings": { "icon": "🔄", "label": "90-Day Guarantee" } }
      ]
    }
  ]
}
{% endschema %}
