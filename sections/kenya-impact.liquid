    {
      "type": "text",
      "id": "credit_text",
      "label": "Photo credit / caption",
      "default": "In partnership with Springboard Connectivity, directed by Tracy Tarlow."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Love Serves All"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Heading — line 1",
      "default": "Giving Back to"
    },
    {
      "type": "text",
      "id": "title_script",
      "label": "Heading — script / accent line",
      "default": "Communities in Need"
    },
    {
      "type": "text",
      "id": "title_after",
