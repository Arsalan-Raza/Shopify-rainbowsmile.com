    {
      "type": "header",
      "content": "Card buttons"
    },
    {
      "type": "text",
      "id": "donate_text",
      "label": "Donate button text",
      "default": "Donate Now"
    },
    {
      "type": "url",
      "id": "donate_url",
      "label": "Donate button link"
    },
    {
      "type": "text",
      "id": "story_text",
      "label": "Story link text",
      "default": "Read the story →"
