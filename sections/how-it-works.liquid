      "info": "Upload a video file. Takes priority over the URL field below."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (external)",
      "info": "Direct .mp4 URL. Used only if no Shopify-hosted video is selected."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Video poster / thumbnail"
    },
    {
      "type": "checkbox",
