  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        { "type": "pill", "settings": { "label": "Vegan"          } },
        { "type": "pill", "settings": { "label": "Plant-Based"    } },
        { "type": "pill", "settings": { "label": "Sugar Free"     } },
