    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Biology Sending"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
    },
    {
      "type": "header",
      "content": "Script line"
    },
    {
      "type": "text",
      "id": "script_text",
      "label": "Script line",
      "default": "Love Signals."
    },
    {
      "type": "select",
      "id": "script_font",
      "label": "Script font",
