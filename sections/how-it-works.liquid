      "default": "<p>Rainbow Smile isn\u2019t just a product. It\u2019s a movement awakening life\u2019s quiet intelligence in your mouth.<\/p>"
    },
    {
      "type": "select",
      "id": "subtitle_font",
      "label": "Subtitle font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
