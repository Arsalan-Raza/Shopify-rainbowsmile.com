{%- style -%}
  /* ── Section wrapper — background + layout ─────────────────── */
  #shopify-section-{{ section.id }} {
    /* Tokens */
    --cb-bg:     {{ section.settings.bg_color }};
    --cb-accent: {{ section.settings.accent_color }};
    --cb-gold:   {{ section.settings.script_color }};
    --cb-green:  {{ section.settings.check_color }};
    --cb-white:  {{ section.settings.text_color }};
    --cb-muted:  {{ section.settings.muted_color }};
    --cb-faint:  {{ section.settings.faint_color }};
    --cb-line:   rgba(255,255,255,0.12);
    --cb-panel:  rgba(255,255,255,0.035);

    /* Layout */
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--cb-bg);
    padding-top:    {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top:    {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Background image layer */
  #shopify-section-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    {%- if section.settings.bg_image != blank -%}
      background-image:    url("{{ section.settings.bg_image | image_url: width: 1800 }}");
      background-size:     cover;
      background-position: center;
      background-repeat:   no-repeat;
    {%- else -%}
      background-image: none;
    {%- endif -%}
    opacity: {{ section.settings.bg_image_opacity | divided_by: 100.0 }};
  }

  /* Radial glow for depth */
  #shopify-section-{{ section.id }}::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(58% 45% at 50% 8%, rgba(96,108,190,0.22), transparent 72%);
    pointer-events: none;
  }

  /* ── Inner div ─────────────────────────────────────────────── */
  .cb-{{ section.id }} {
    padding-inline: clamp(1.25rem, 5vw, 2rem);
    color: var(--cb-white);
  }

  .cb-{{ section.id }} * { box-sizing: border-box; }

  /* ── Inner ─────────────────────────────────────────────────── */
  .cb-{{ section.id }} .cb__inner {
    max-width: 1120px;
    margin-inline: auto;
    text-align: center;
  }

  /* ── Pill badge ────────────────────────────────────────────── */
  .cb-{{ section.id }} .cb__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.6rem 1.35rem;
    border: 1px solid var(--cb-line);
    border-radius: 999px;
    background: var(--cb-panel);
    font-family: var({{ section.settings.pill_font }});
    font-weight: 700;
    font-size: clamp(12px, 1.4vw, 13px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cb-white);
    white-space: nowrap;
  }
  .cb-{{ section.id }} .cb__pill svg {
    width: 0.9em;
    height: 0.9em;
    flex: none;
    color: var(--cb-green);
  }

  /* ── Eyebrow ───────────────────────────────────────────────── */
  .cb-{{ section.id }} .cb__eyebrow {
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 clamp(0.75rem, 2vw, 1rem);
    font-family: var({{ section.settings.eyebrow_font }});
    font-weight: 500;
    font-size: clamp(12px, 1.6vw, 14px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cb-accent);
  }

  /* ── Heading ───────────────────────────────────────────────── */
  .cb-{{ section.id }} .cb__title {
    margin: 0;
    font-family: var({{ section.settings.heading_font }});
    font-weight: 700;
    font-size: clamp(40px, 5.6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--cb-white);
  }
  .cb-{{ section.id }} .cb__title sup {
    font-size: 0.4em;
    vertical-align: super;
    font-weight: 700;
  }

  /* ── Script line ───────────────────────────────────────────── */
  .cb-{{ section.id }} .cb__script {
    display: block;
    margin-top: 0.12em;
    font-family: var({{ section.settings.script_font }});
    font-weight: 400;
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1.04;
    color: var(--cb-gold);
  }

  /* ── Stats box ─────────────────────────────────────────────── */
  .cb-{{ section.id }} .cb__stats {
    display: flex;
    max-width: 720px;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    border: 1px solid var(--cb-line);
    border-radius: 22px;
    background: var(--cb-panel);
    overflow: hidden;
  }

  .cb-{{ section.id }} .cb__stat {
    flex: 1;
    padding: clamp(1.75rem, 4vw, 2.5rem) clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }
  .cb-{{ section.id }} .cb__stat + .cb__stat {
    border-left: 1px solid var(--cb-line);
  }

  .cb-{{ section.id }} .cb__stat-num {
    font-family: var({{ section.settings.stat_num_font }});
    font-weight: 700;
    font-size: clamp(40px, 5vw, 58px);
    line-height: 1;
    color: var(--cb-accent);
  }
  .cb-{{ section.id }} .cb__stat-label {
    max-width: 22ch;
    font-family: var({{ section.settings.stat_label_font }});
    font-weight: 400;
    font-size: clamp(12px, 1.4vw, 13px);
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cb-muted);
  }

  /* ── Disclaimer ────────────────────────────────────────────── */
  .cb-{{ section.id }} .cb__disclaimer {
    max-width: 760px;
    margin: clamp(2rem, 4vw, 2.75rem) auto 0;
    font-family: var({{ section.settings.disclaimer_font }});
    font-weight: 400;
    font-size: 12px;
    line-height: 1.7;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cb-faint);
  }

  /* ── Mobile ────────────────────────────────────────────────── */
  @media screen and (max-width: 749px) {
    .cb-{{ section.id }} .cb__pill { letter-spacing: 0.08em; }

    .cb-{{ section.id }} .cb__stats { flex-direction: column; }
    .cb-{{ section.id }} .cb__stat + .cb__stat {
      border-left: none;
      border-top: 1px solid var(--cb-line);
    }
    .cb-{{ section.id }} .cb__stat-label { max-width: 26ch; }
  }
{%- endstyle -%}

<div class="cb-{{ section.id }}">
  <div class="cb__inner">

    {%- comment -%} Pill badge {%- endcomment -%}
    {%- if section.settings.show_pill and section.settings.pill_text != blank -%}
      <span class="cb__pill">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {{ section.settings.pill_text | escape }}
      </span>
    {%- endif -%}

    {%- comment -%} Eyebrow {%- endcomment -%}
    {%- if section.settings.eyebrow_text != blank -%}
      <p class="cb__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
    {%- endif -%}

    {%- comment -%} Heading {%- endcomment -%}
    {%- if section.settings.heading_text != blank or section.settings.script_text != blank -%}
      <h2 class="cb__title">
        {%- if section.settings.heading_text != blank -%}
          {{ section.settings.heading_text | escape }}
          {%- if section.settings.heading_sup != blank -%}
            <sup>{{ section.settings.heading_sup | escape }}</sup>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.script_text != blank -%}
          <span class="cb__script">{{ section.settings.script_text | escape }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- comment -%} Stats {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="cb__stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="cb__stat" {{ block.shopify_attributes }}>
              {%- if block.settings.stat_num != blank -%}
                <span class="cb__stat-num">{{ block.settings.stat_num | escape }}</span>
              {%- endif -%}
              {%- if block.settings.stat_label != blank -%}
                <span class="cb__stat-label">{{ block.settings.stat_label | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Disclaimer {%- endcomment -%}
    {%- if section.settings.show_disclaimer and section.settings.disclaimer_text != blank -%}
      <p class="cb__disclaimer">{{ section.settings.disclaimer_text | escape }}</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Clinical Study Banner",
  "tag": "section",
  "class": "clinical-study-banner-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Background"
