{%- style -%}
  #shopify-section-{{ section.id }} {
    --bh-navy:  {{ section.settings.navy_color }};
    --bh-coral: {{ section.settings.coral_color }};
    --bh-olive: {{ section.settings.olive_color }};
    --bh-intro: {{ section.settings.intro_color }};
    --bh-body:  {{ section.settings.body_color }};
    --bh-line:  {{ section.settings.line_color }};
  }
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} .bhk {
    background: {{ section.settings.bg_color }};
    padding-block: clamp(44px, 6vw, 80px);
    padding-inline: clamp(20px, 5vw, 48px);
  }

  #shopify-section-{{ section.id }} .bhk * { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .bhk__inner { max-width: 1120px; margin-inline: auto; }

  /* ---------- Header ---------- */
  #shopify-section-{{ section.id }} .bhk__head { text-align: center; margin-bottom: clamp(34px, 5vw, 56px); }

  #shopify-section-{{ section.id }} .bhk__eyebrow {
    margin: 0 0 clamp(12px, 2vw, 18px);
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 500;
    font-size: clamp(14px, 1.1vw, 15px);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--bh-coral);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .bhk__title {
    margin: 0;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 800;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.06;
    letter-spacing: -0.5px;
    color: var(--bh-navy);
  }

  #shopify-section-{{ section.id }} .bhk__script {
    display: block;
    margin-top: 2px;
    font-family: var(--font-{{ section.settings.script_font }}-family);
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.14;
    color: var(--bh-coral);
  }

  #shopify-section-{{ section.id }} .bhk__tagline {
    margin: clamp(12px, 2vw, 18px) 0 0;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 700;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.3;
    color: var(--bh-olive);
  }

  #shopify-section-{{ section.id }} .bhk__intro {
    margin: clamp(20px, 3vw, 30px) auto 0;
    max-width: 560px;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.7;
    color: var(--bh-intro);
  }

  /* ---------- Cards ---------- */
  #shopify-section-{{ section.id }} .bhk__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2vw, 26px);
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .bhk__card {
    border: 1px solid var(--bh-line);
    border-radius: 14px;
    padding: clamp(22px, 2.6vw, 30px);
    background: {{ section.settings.bg_color }};
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  #shopify-section-{{ section.id }} .bhk__card:hover {
    border-color: #ddd4c6;
    box-shadow: 0 12px 28px rgba(80, 65, 45, 0.07);
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .bhk__num {
    margin: 0 0 clamp(14px, 2vw, 20px);
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.6px;
    color: var(--bh-coral);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .bhk__card-title {
    margin: 0 0 12px;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.3;
    color: var(--bh-navy);
  }

  #shopify-section-{{ section.id }} .bhk__card-body {
    margin: 0;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.65;
    color: var(--bh-body);
  }

  @media (max-width: 780px) {
    #shopify-section-{{ section.id }} .bhk__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .bhk__card:hover { transform: none; }
  }
</style>

<div class="bhk">
  <div class="bhk__inner">

    <header class="bhk__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="bhk__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank or section.settings.script_line != blank -%}
        <h2 class="bhk__title">
          {{- section.settings.title | escape -}}
          {%- if section.settings.script_line != blank -%}
            <span class="bhk__script">{{ section.settings.script_line | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="bhk__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <p class="bhk__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="bhk__grid">
        {%- for block in section.blocks -%}
          <article class="bhk__card" {{ block.shopify_attributes }}>
            {%- if block.settings.num != blank -%}
              <p class="bhk__num">{{ block.settings.num | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="bhk__card-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="bhk__card-body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
