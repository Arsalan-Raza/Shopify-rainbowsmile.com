{%- style -%}
  #shopify-section-{{ section.id }} {
    --edu-bg:     {{ section.settings.bg_color }};
    --edu-navy:   {{ section.settings.navy_color }};
    --edu-accent: {{ section.settings.accent_color }};
    --edu-meta:   {{ section.settings.meta_color }};
    --edu-card:   {{ section.settings.card_color }};
    --edu-line:   {{ section.settings.line_color }};

    background: var(--edu-bg);
    padding-block: clamp(44px, 6vw, 80px);
    padding-inline: clamp(20px, 5vw, 48px);
  }

  .edu-{{ section.id }} * { box-sizing: border-box; }
  .edu-{{ section.id }} .edu__inner { max-width: 1180px; margin-inline: auto; }

  /* ── Header ─────────────────────────────────────────────────── */
  .edu-{{ section.id }} .edu__head {
    text-align: center;
    margin-bottom: clamp(32px, 4.5vw, 54px);
  }

  .edu-{{ section.id }} .edu__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-family: var(--font-{{ section.settings.eyebrow_font }}-family);
    font-weight: 700;
    font-size: clamp(12px, 1.1vw, 13px);
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--edu-accent);
    line-height: 1;
  }
  .edu-{{ section.id }} .edu__eyebrow::before {
    content: "";
    width: 24px;
    height: 2px;
    background: currentColor;
    flex: none;
  }

  .edu-{{ section.id }} .edu__title {
    margin: 0;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 800;
    font-size: clamp(32px, 4.2vw, 50px);
    line-height: 1.02;
    letter-spacing: -0.5px;
    color: var(--edu-navy);
  }
  .edu-{{ section.id }} .edu__script {
    display: block;
    margin-top: 2px;
    font-family: var(--font-{{ section.settings.script_font }}-family);
    font-weight: 400;
    font-size: clamp(30px, 3.8vw, 46px);
    line-height: 1.1;
    color: var(--edu-accent);
  }

  /* ── Grid ───────────────────────────────────────────────────── */
  .edu-{{ section.id }} .edu__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: clamp(18px, 2.2vw, 26px);
    align-items: stretch;
  }

  /* ── Card ───────────────────────────────────────────────────── */
  .edu-{{ section.id }} .edu__card {
    background: var(--edu-card);
    border: 1px solid var(--edu-line);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  @media (hover: hover) {
    .edu-{{ section.id }} .edu__card:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 30px rgba(70, 55, 40, 0.10);
    }
  }
  .edu-{{ section.id }} .edu__card:focus-visible {
    outline: 3px solid rgba(244, 80, 43, 0.4);
    outline-offset: 3px;
  }

  .edu-{{ section.id }} .edu__media {
    aspect-ratio: 4 / 3;
    background: linear-gradient(160deg, #e6d9cf, #f4ece2);
    overflow: hidden;
  }
  .edu-{{ section.id }} .edu__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .edu-{{ section.id }} .edu__content {
    padding: clamp(18px, 2vw, 24px);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .edu-{{ section.id }} .edu__category {
    margin: 0 0 14px;
    font-family: var(--font-{{ section.settings.meta_font }}-family);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--edu-accent);
  }

  .edu-{{ section.id }} .edu__name {
    margin: 0 0 clamp(18px, 2.2vw, 24px);
    font-family: var(--font-{{ section.settings.name_font }}-family);
    font-weight: 700;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.35;
    color: var(--edu-navy);
  }

  .edu-{{ section.id }} .edu__meta {
    margin: auto 0 0;
    font-family: var(--font-{{ section.settings.meta_font }}-family);
    font-weight: 400;
    font-size: 13px;
    line-height: 1.4;
    color: var(--edu-meta);
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media screen and (max-width: 899px) {
    .edu-{{ section.id }} .edu__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 620px) {
    .edu-{{ section.id }} .edu__grid { grid-template-columns: 1fr; }
    .edu-{{ section.id }} .edu__media { aspect-ratio: 16 / 10; }
  }
  @media (prefers-reduced-motion: reduce) {
    .edu-{{ section.id }} .edu__card:hover { transform: none; }
  }
{%- endstyle -%}

{%- liquid
  if section.settings.blog != blank
    assign blog_source = blogs[section.settings.blog]
    assign article_list = blog_source.articles
  endif
-%}

<div class="edu-{{ section.id }}">
  <div class="edu__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="edu__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="edu__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank or section.settings.script_line != blank -%}
          <h2 class="edu__title">
            {{- section.settings.heading | escape -}}
            {%- if section.settings.script_line != blank -%}
              <span class="edu__script">{{ section.settings.script_line | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="edu__grid">
      {%- if article_list != blank -%}
        {%- for article in article_list limit: section.settings.articles_to_show -%}

          {%- comment -%} Estimate read time at ~200 wpm {%- endcomment -%}
          {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
          {%- assign read_minutes = word_count | divided_by: 200 | at_least: 1 -%}

          {%- comment -%} First tag becomes the category label {%- endcomment -%}
          {%- assign category_tag = article.tags | first -%}

          {%- assign article_img_alt = article.image.alt | default: article.title | escape -%}

          <a class="edu__card" href="{{ article.url }}">
            <div class="edu__media">
              {%- if article.image != blank -%}
                {{
                  article.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    alt: article_img_alt,
                    widths: '400, 600, 800'
                }}
              {%- endif -%}
            </div>
            <div class="edu__content">
              {%- if category_tag != blank -%}
                <p class="edu__category">{{ category_tag | escape }}</p>
              {%- endif -%}
              <h3 class="edu__name">{{ article.title | escape }}</h3>
              <p class="edu__meta">
                {{- read_minutes }} {{ 'sections.education.min_read' | t: default: 'min read' }}
                {%- if article.author != blank %} · {{ 'sections.education.by' | t: default: 'By' }} {{ article.author | escape }}{%- endif -%}
              </p>
            </div>
          </a>

        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Editor placeholder when no blog is selected {%- endcomment -%}
        {%- for i in (1..section.settings.articles_to_show) -%}
          <div class="edu__card">
            <div class="edu__media">{{ 'image' | placeholder_svg_tag }}</div>
            <div class="edu__content">
              <p class="edu__category">{{ section.settings.eyebrow | default: 'Category' | escape }}</p>
              <h3 class="edu__name">Select a blog in section settings to display articles here.</h3>
              <p class="edu__meta">5 min read · Author Name</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Education Articles",
  "tag": "section",
  "class": "education-articles-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Education"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Learn something"
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script line",
      "default": "new today."
    },
    {
      "type": "header",
      "content": "Blog source"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Fonts"
    },
    {
      "type": "select",
      "id": "eyebrow_font",
      "label": "Eyebrow font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "tag"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "script_font",
      "label": "Script line font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "accent"
    },
    {
      "type": "select",
      "id": "name_font",
      "label": "Article title font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "meta_font",
      "label": "Category / meta font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "tag"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#fdf8f2"
    },
    {
      "type": "color",
      "id": "navy_color",
      "label": "Heading & title color",
      "default": "#232748"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow, script & category color",
      "default": "#f4502b"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta text color",
      "default": "#bdb2a4"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Card border color",
      "default": "#efe8de"
    }
  ],
  "presets": [
    {
      "name": "Education Articles"
    }
  ]
}
{% endschema %}
