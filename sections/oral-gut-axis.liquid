{%- style -%}
  /* ── Section wrapper ───────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    --og-bg:     {{ section.settings.bg_color }};
    --og-navy:   {{ section.settings.heading_color }};
    --og-body:   {{ section.settings.body_color }};
    --og-accent: {{ section.settings.accent_color }};
    --og-panel:  {{ section.settings.panel_color }};
    --og-card:   {{ section.settings.card_bg_color }};
    --og-meta:   {{ section.settings.meta_color }};
    --og-card-w: 248px;

    background: var(--og-bg);
    padding-top:    {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-inline: clamp(20px, 5vw, 48px);
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top:    {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Inner grid ────────────────────────────────────────────── */
  .og-{{ section.id }} * { box-sizing: border-box; }

  .og-{{ section.id }} .og__inner {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.02fr 1fr;
    align-items: center;
    gap: clamp(40px, 6vw, 90px);
  }

  /* ── Left: content ─────────────────────────────────────────── */
  .og-{{ section.id }} .og__content { max-width: 560px; }

  .og-{{ section.id }} .og__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-family: var({{ section.settings.eyebrow_font }});
    font-weight: 500;
    font-size: clamp(13px, 1.1vw, 14px);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--og-accent);
    line-height: 1;
  }
  .og-{{ section.id }} .og__eyebrow::before {
    content: "";
    width: 26px;
    height: 2px;
    background: currentColor;
    flex: none;
  }

  .og-{{ section.id }} .og__title {
    margin: 0;
    font-family: var({{ section.settings.heading_font }});
    font-weight: 700;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.04;
    letter-spacing: -0.5px;
    color: var(--og-navy);
  }

  .og-{{ section.id }} .og__script {
    display: block;
    margin-top: 2px;
    font-family: var({{ section.settings.script_font }});
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.05;
    color: var(--og-accent);
  }

  .og-{{ section.id }} .og__body { margin-top: clamp(20px, 3vw, 28px); }
  .og-{{ section.id }} .og__body p {
    margin: 0;
    font-family: var({{ section.settings.body_font }});
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.65;
    color: var(--og-body);
  }
  .og-{{ section.id }} .og__body p + p { margin-top: 18px; }
  .og-{{ section.id }} .og__body strong { font-weight: 700; color: var(--og-navy); }
  .og-{{ section.id }} .og__body sup { font-size: 0.6em; vertical-align: super; }

  .og-{{ section.id }} .og__cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: clamp(26px, 4vw, 36px);
    padding: 10px 32px;
    border-radius: 999px;
    background: var(--og-accent);
    color: #fff;
    font-family: var({{ section.settings.cta_font }});
    font-weight: 400;
    font-size: clamp(16px, 1.3vw, 17px);
    text-decoration: none;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }
  .og-{{ section.id }} .og__cta span { transition: transform 0.18s ease; }
  .og-{{ section.id }} .og__cta:hover { background: #df431f; }
  .og-{{ section.id }} .og__cta:hover span { transform: translateX(3px); }
  .og-{{ section.id }} .og__cta:focus-visible {
    outline: 3px solid rgba(244,80,43,0.4);
    outline-offset: 2px;
  }

  /* ── Right: diagram panel ──────────────────────────────────── */
  .og-{{ section.id }} .og__diagram {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--og-panel);
    border-radius: 24px;
    padding: clamp(28px, 4vw, 52px) clamp(20px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Cards ─────────────────────────────────────────────────── */
  .og-{{ section.id }} .og__card {
    width: 100%;
    max-width: var(--og-card-w);
    background: var(--og-card);
    border-radius: 16px;
    padding: 26px 24px;
    text-align: center;
    box-shadow: 0 12px 30px rgba(40,33,0,0.10);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .og-{{ section.id }} .og__card-icon {
    font-size: 36px;
    line-height: 1;
  }
  .og-{{ section.id }} .og__card-title {
    margin: 0;
    font-family: var({{ section.settings.card_title_font }});
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.1;
    color: var(--og-navy);
  }
  .og-{{ section.id }} .og__card-meta {
    margin: 0;
    font-family: var({{ section.settings.card_meta_font }});
    font-weight: 400;
    font-size: clamp(13px, 1.1vw, 14px);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--og-meta);
  }

  /* ── Axis connectors ───────────────────────────────────────── */
  .og-{{ section.id }} .og__connector {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-block: clamp(14px, 2vw, 20px);
    font-family: var({{ section.settings.connector_font }});
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--og-navy);
  }
  .og-{{ section.id }} .og__connector-arrow {
    color: var(--og-accent);
    font-size: 15px;
    line-height: 1;
  }

  /* ── Mobile ────────────────────────────────────────────────── */
  @media screen and (max-width: 859px) {
    .og-{{ section.id }} .og__inner {
      grid-template-columns: 1fr;
      gap: clamp(36px, 7vw, 48px);
    }
    .og-{{ section.id }} .og__content { max-width: 600px; }
    .og-{{ section.id }} { --og-card-w: 340px; }
  }

  @media screen and (max-width: 480px) {
    .og-{{ section.id }} .og__cta { width: 100%; justify-content: center; }
  }
{%- endstyle -%}

<div class="og-{{ section.id }}">
  <div class="og__inner">

    {%- comment -%} ── LEFT: content ── {%- endcomment -%}
    <div class="og__content">

      {%- if section.settings.eyebrow_text != blank -%}
        <p class="og__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading_text != blank or section.settings.script_text != blank -%}
        <h2 class="og__title">
          {%- if section.settings.heading_text != blank -%}
            {{ section.settings.heading_text | escape }}
          {%- endif -%}
          {%- if section.settings.script_text != blank -%}
            <span class="og__script">{{ section.settings.script_text | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.body_text != blank -%}
        <div class="og__body">{{ section.settings.body_text }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="og__cta" href="{{ section.settings.cta_url }}">
          {{ section.settings.cta_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}

    </div>

    {%- comment -%} ── RIGHT: diagram ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="og__diagram">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="og__card" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="og__card-icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="og__card-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.meta != blank -%}
                <p class="og__card-meta">{{ block.settings.meta | escape }}</p>
              {%- endif -%}
            </div>

          {%- elsif block.type == 'connector' -%}
            <div class="og__connector" {{ block.shopify_attributes }}>
              <span class="og__connector-arrow" aria-hidden="true">&darr;</span>
              {{ block.settings.label | escape }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

