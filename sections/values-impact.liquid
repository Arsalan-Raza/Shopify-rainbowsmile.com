{%- style -%}
  /* ── Section wrapper ───────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    --val-bg:     {{ section.settings.bg_color }};
    --val-navy:   {{ section.settings.heading_color }};
    --val-body:   {{ section.settings.body_color }};
    --val-accent: {{ section.settings.accent_color }};

    /* Card tints */
    --val-cream:    linear-gradient(120deg, #f6efe1, #faf6ef);
    --val-lavender: linear-gradient(120deg, #ece9f7, #f4f1fb);
    --val-blue:     linear-gradient(120deg, #e4edf8, #eef4fc);
    --val-green:    linear-gradient(120deg, #e9f1df, #f3f8ec);

    background: var(--val-bg);
    padding-top:    {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-inline: clamp(20px, 5vw, 48px);
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top:    {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Inner ─────────────────────────────────────────────────── */
  .vi-{{ section.id }} * { box-sizing: border-box; }
  .vi-{{ section.id }} .vi__inner { max-width: 1180px; margin-inline: auto; }

  /* ── Header ────────────────────────────────────────────────── */
  .vi-{{ section.id }} .vi__head {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .vi-{{ section.id }} .vi__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-family: var({{ section.settings.eyebrow_font }});
    font-weight: 700;
    font-size: clamp(12px, 1.2vw, 13px);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--val-accent);
    line-height: 1;
  }
  .vi-{{ section.id }} .vi__eyebrow::before {
    content: "";
    width: 26px;
    height: 2px;
    background: currentColor;
    flex: none;
  }

  .vi-{{ section.id }} .vi__title {
    margin: 0;
    font-family: var({{ section.settings.heading_font }});
    font-weight: 700;
    font-size: clamp(34px, 4.4vw, 52px);
    line-height: 1.04;
    letter-spacing: -0.5px;
    color: var(--val-navy);
  }

  .vi-{{ section.id }} .vi__script {
    display: block;
    margin-top: 2px;
    font-family: var({{ section.settings.script_font }});
    font-weight: 400;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.05;
    color: var(--val-accent);
  }

  /* ── Rows ──────────────────────────────────────────────────── */
  .vi-{{ section.id }} .vi__rows {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 36px);
  }

  .vi-{{ section.id }} .vi__row {
    display: grid;
    grid-template-columns: 3.2fr 1fr;
    gap: clamp(16px, 2vw, 22px);
    align-items: stretch;
    min-height: clamp(260px, 30vw, 300px);
  }
  .vi-{{ section.id }} .vi__row--reverse {
    grid-template-columns: 1fr 3.2fr;
  }

  /* ── Card ──────────────────────────────────────────────────── */
  .vi-{{ section.id }} .vi__card {
    border-radius: 20px;
    padding: clamp(30px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .vi-{{ section.id }} .vi__card--cream    { background: var(--val-cream); }
  .vi-{{ section.id }} .vi__card--lavender { background: var(--val-lavender); }
  .vi-{{ section.id }} .vi__card--blue     { background: var(--val-blue); }
  .vi-{{ section.id }} .vi__card--green    { background: var(--val-green); }

  .vi-{{ section.id }} .vi__icon {
    display: block;
    font-size: 38px;
    line-height: 1;
    margin-bottom: clamp(16px, 2vw, 22px);
  }

  .vi-{{ section.id }} .vi__card-title {
    margin: 0 0 12px;
    font-family: var({{ section.settings.card_title_font }});
    font-weight: 700;
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.15;
    color: var(--val-navy);
  }

  .vi-{{ section.id }} .vi__card-body {
    margin: 0;
    max-width: 70ch;
    font-family: var({{ section.settings.card_body_font }});
    font-weight: 400;
    font-size: clamp(15px, 1.3vw, 16px);
    line-height: 1.65;
    color: var(--val-body);
  }

  /* ── Media ─────────────────────────────────────────────────── */
  .vi-{{ section.id }} .vi__media { display: flex; }
  .vi-{{ section.id }} .vi__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
    display: block;
    aspect-ratio:  1 / 1;
  }

  /* ── Mobile ────────────────────────────────────────────────── */
  @media screen and (max-width: 859px) {
    .vi-{{ section.id }} .vi__row,
    .vi-{{ section.id }} .vi__row--reverse {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 0;
    }
    .vi-{{ section.id }} .vi__media {
      order: -1;
      aspect-ratio: 4 / 3;
    }
    .vi-{{ section.id }} .vi__media img {
      border-radius: 20px 20px 0 0;
    }
    .vi-{{ section.id }} .vi__card {
      border-radius: 0 0 20px 20px;
    }
  }
{%- endstyle -%}

<div class="vi-{{ section.id }}">
  <div class="vi__inner">

    {%- comment -%} ── Header ── {%- endcomment -%}
    {%- if section.settings.eyebrow_text != blank
        or section.settings.heading_text != blank
        or section.settings.script_text != blank -%}
      <header class="vi__head">
        {%- if section.settings.eyebrow_text != blank -%}
          <p class="vi__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading_text != blank or section.settings.script_text != blank -%}
          <h2 class="vi__title">
            {{ section.settings.heading_text | escape }}
            {%- if section.settings.script_text != blank -%}
              <span class="vi__script">{{ section.settings.script_text | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%} ── Rows ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="vi__rows">
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            {%- assign is_reverse = false -%}
            {%- if block.settings.layout == 'reverse' -%}
              {%- assign is_reverse = true -%}
            {%- endif -%}

            <div class="vi__row{% if is_reverse %} vi__row--reverse{% endif %}" {{ block.shopify_attributes }}>

              {%- if is_reverse -%}
                {%- comment -%} Image left {%- endcomment -%}
                <div class="vi__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', alt: block.settings.image.alt | default: '' }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="vi__card vi__card--{{ block.settings.tint }}">
                  {%- if block.settings.icon != blank -%}
                    <span class="vi__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                  {%- endif -%}
                  {%- if block.settings.card_title != blank -%}
                    <h3 class="vi__card-title">{{ block.settings.card_title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.card_body != blank -%}
                    <p class="vi__card-body">{{ block.settings.card_body | escape }}</p>
                  {%- endif -%}
                </div>

              {%- else -%}
                {%- comment -%} Card left, image right {%- endcomment -%}
                <div class="vi__card vi__card--{{ block.settings.tint }}">
                  {%- if block.settings.icon != blank -%}
                    <span class="vi__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                  {%- endif -%}
                  {%- if block.settings.card_title != blank -%}
                    <h3 class="vi__card-title">{{ block.settings.card_title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.card_body != blank -%}
                    <p class="vi__card-body">{{ block.settings.card_body | escape }}</p>
                  {%- endif -%}
                </div>
                <div class="vi__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', alt: block.settings.image.alt | default: '' }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              {%- endif -%}

            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Values & Impact",
  "tag": "section",
  "class": "values-impact-section",
  "max_blocks": 8,
  "settings": [
