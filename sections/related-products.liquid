{%- style -%}
  /* ── Section wrapper ───────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    --xs-navy:   {{ section.settings.navy_color }};
    --xs-accent: {{ section.settings.accent_color }};
    --xs-gold:   {{ section.settings.gold_color }};
    --xs-meta:   {{ section.settings.meta_color }};
    --xs-line:   {{ section.settings.line_color }};
    --xs-card:   {{ section.settings.card_color }};
    --xs-card-w: {{ section.settings.card_width }}px;

    background: {{ section.settings.bg_color }};
    padding-block: clamp(44px, 6vw, 80px);
    padding-inline: clamp(20px, 5vw, 48px);
  }

  .xsell-{{ section.id }} * { box-sizing: border-box; }

  .xsell-{{ section.id }} .xs__inner {
    max-width: 1180px;
    margin-inline: auto;
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .xsell-{{ section.id }} .xs__head {
    text-align: center;
    margin-bottom: clamp(32px, 4.5vw, 52px);
  }
  .xsell-{{ section.id }} .xs__title {
    margin: 0;
    font-family: var({{ section.settings.heading_font }});
    font-weight: 800;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.04;
    letter-spacing: -0.5px;
    color: var(--xs-navy);
  }
  .xsell-{{ section.id }} .xs__script {
    display: block;
    margin-top: 2px;
    font-family: var({{ section.settings.script_font }});
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.1;
    color: var(--xs-accent);
  }

  /* ── Cards ──────────────────────────────────────────────────── */
  .xsell-{{ section.id }} .xs__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(18px, 2.2vw, 26px);
  }
  .xsell-{{ section.id }} .xs__card {
    width: var(--xs-card-w);
    max-width: 100%;
    background: var(--xs-card);
    border: 1px solid var(--xs-line);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  @media (hover: hover) {
    .xsell-{{ section.id }} .xs__card:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 32px rgba(35, 39, 72, 0.10);
    }
  }
  .xsell-{{ section.id }} .xs__card:focus-visible {
    outline: 3px solid rgba(244, 80, 43, 0.4);
    outline-offset: 3px;
  }

  /* ── Media ──────────────────────────────────────────────────── */
  .xsell-{{ section.id }} .xs__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: linear-gradient(165deg, #eef0e2, #faf7ef);
    overflow: hidden;
  }
  .xsell-{{ section.id }} .xs__media img,
  .xsell-{{ section.id }} .xs__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Badge ──────────────────────────────────────────────────── */
  .xsell-{{ section.id }} .xs__badge {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 8px 15px;
    border-radius: 8px;
    background: var(--xs-gold);
    font-family: var({{ section.settings.badge_font }});
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--xs-navy);
    white-space: nowrap;
  }

  /* ── Content ────────────────────────────────────────────────── */
  .xsell-{{ section.id }} .xs__content {
    padding: clamp(20px, 2.2vw, 26px);
  }
  .xsell-{{ section.id }} .xs__meta {
    margin: 0 0 14px;
    font-family: var({{ section.settings.meta_font }});
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--xs-meta);
  }
  .xsell-{{ section.id }} .xs__name {
    margin: 0;
    font-family: var({{ section.settings.name_font }});
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.2;
    color: var(--xs-navy);
  }

  @media (prefers-reduced-motion: reduce) {
    .xsell-{{ section.id }} .xs__card { transition: none; }
  }
{%- endstyle -%}

<product-recommendations
  class="xsell-{{ section.id }}"
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="xs__inner">

      {%- if section.settings.heading_text != blank or section.settings.script_text != blank -%}
        <header class="xs__head">
          <h2 class="xs__title">
            {{- section.settings.heading_text | escape -}}
            {%- if section.settings.script_text != blank -%}
              <span class="xs__script">{{ section.settings.script_text | escape }}</span>
            {%- endif -%}
          </h2>
        </header>
      {%- endif -%}

      <div class="xs__grid">
        {%- for recommendation in recommendations.products -%}
          <a class="xs__card" href="{{ recommendation.url }}">

            <div class="xs__media">
              {%- if recommendation.featured_image != blank -%}
                {%- assign rec_alt = recommendation.featured_image.alt | default: recommendation.title | escape -%}
                {{
                  recommendation.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    alt: rec_alt,
                    widths: '330, 660, 700'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if section.settings.badge_text != blank -%}
                <span class="xs__badge">{{ section.settings.badge_text | escape }}</span>
              {%- endif -%}
            </div>

            <div class="xs__content">
              {%- if recommendation.type != blank -%}
                <p class="xs__meta">{{ recommendation.type | escape }}</p>
              {%- endif -%}
              <h3 class="xs__name">{{ recommendation.title | escape }}</h3>
            </div>

          </a>
        {%- endfor -%}
      </div>

    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "related-products-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "To select products, add a source in the Search & Discovery app."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Products"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
    },
    {
      "type": "header",
      "content": "Script line"
    },
    {
      "type": "text",
      "id": "script_text",
      "label": "Script line",
      "default": "recommendation"
    },
    {
      "type": "select",
      "id": "script_font",
      "label": "Script font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-accent-family"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 240,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 330,
      "label": "Card width"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Subscribe & Save",
      "info": "Leave blank to hide the badge."
    },
    {
      "type": "select",
      "id": "badge_font",
      "label": "Badge font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-tag-family"
    },
    {
      "type": "select",
      "id": "meta_font",
      "label": "Product type font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-tag-family"
    },
    {
      "type": "select",
      "id": "name_font",
      "label": "Product name font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "navy_color",
      "label": "Heading & product name color",
      "default": "#232748"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Script line color",
      "default": "#f4502b"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Badge background",
      "default": "#f5b731"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Product type color",
      "default": "#f0a93a"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Card border color",
      "default": "#ececec"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
