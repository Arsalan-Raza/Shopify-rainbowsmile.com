{%- if section.settings.enable -%}

{%- style -%}
  .satc-{{ section.id }} {
    --satc-bg:     {{ section.settings.bg_color }};
    --satc-navy:   {{ section.settings.navy_color }};
    --satc-meta:   {{ section.settings.meta_color }};
    --satc-btn:    {{ section.settings.btn_color }};
    --satc-btn-hv: {{ section.settings.btn_hover_color }};
    --satc-shadow: 0 -6px 28px rgba(30, 25, 20, 0.14);
    --satc-radius: 10px;
    --satc-inset:  clamp(10px, 2vw, 22px);

    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    padding: 0 var(--satc-inset) var(--satc-inset);
    pointer-events: none;

    /* start off-screen below */
    transform: translateY(calc(100% + var(--satc-inset)));
    transition: transform 0.32s cubic-bezier(0.34, 1.1, 0.64, 1);
  }

  .satc-{{ section.id }}.is-visible {
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .satc-{{ section.id }} { transition: transform 0.18s ease; }
  }

  .satc-{{ section.id }} * { box-sizing: border-box; }

  .satc-{{ section.id }} .satc__bar {
    max-width: 1500px;
    margin-inline: auto;
    background: var(--satc-bg);
    border-radius: var(--satc-radius);
    box-shadow: var(--satc-shadow);
    padding: clamp(12px, 1.4vw, 16px) clamp(14px, 2vw, 26px);
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 20px);
  }

  /* ── Product info ────────────────────────────────────────────── */
  .satc-{{ section.id }} .satc__product {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.4vw, 16px);
    min-width: 0;
    flex: 1;
  }
  .satc-{{ section.id }} .satc__thumb {
    width: clamp(36px, 4vw, 46px);
    height: clamp(36px, 4vw, 46px);
    flex: none;
    border-radius: 5px;
    object-fit: cover;
    display: block;
    background: linear-gradient(160deg, #eceee0, #f8f5ec);
  }
  .satc-{{ section.id }} .satc__info { min-width: 0; }

  .satc-{{ section.id }} .satc__name {
    margin: 0 0 3px;
    font-family: var({{ section.settings.name_font }});
    font-weight: 700;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.25;
    color: var(--satc-navy);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .satc-{{ section.id }} .satc__price {
    margin: 0;
    font-family: var({{ section.settings.price_font }});
    font-weight: 400;
    font-size: clamp(12px, 1.2vw, 14px);
    line-height: 1.3;
    color: var(--satc-meta);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── Button ──────────────────────────────────────────────────── */
  .satc-{{ section.id }} .satc__btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px clamp(20px, 2.4vw, 34px);
    border: none;
    border-radius: 999px;
    background: var(--satc-btn);
    color: #fff;
    font-family: var({{ section.settings.btn_font }});
    font-weight: 400;
    font-size: clamp(14px, 1.4vw, 15px);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }
  .satc-{{ section.id }} .satc__btn:hover {
    background: var(--satc-btn-hv);
    transform: translateY(-1px);
  }
  .satc-{{ section.id }} .satc__btn:focus-visible {
    outline: 3px solid rgba(239, 77, 36, 0.45);
    outline-offset: 3px;
  }
  .satc-{{ section.id }} .satc__btn[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .satc-{{ section.id }} .satc__btn:hover { transform: none; }
  }

  /* ── Mobile ──────────────────────────────────────────────────── */
  @media screen and (max-width: 480px) {
    .satc-{{ section.id }} { --satc-inset: 8px; }
    .satc-{{ section.id }} .satc__bar { padding: 10px 12px; gap: 10px; }
    .satc-{{ section.id }} .satc__btn { padding: 12px 18px; }
  }
{%- endstyle -%}

<div class="satc-{{ section.id }}" id="satc-{{ section.id }}" aria-hidden="true" aria-label="{{ section.settings.bar_label | escape }}">
  <div class="satc__bar">

    <div class="satc__product">
      {%- if section.settings.show_image and product.featured_image != blank -%}
        {{
          product.featured_image
          | image_url: width: 120
          | image_tag:
            class: 'satc__thumb',
            loading: 'lazy',
            alt: product.featured_image.alt | default: product.title | escape
        }}
      {%- endif -%}

      <div class="satc__info">
        <p class="satc__name">{{ product.title | escape }}</p>
        {%- if section.settings.show_price -%}
          <p class="satc__price" id="satc-price-{{ section.id }}">
            {{ product.selected_or_first_available_variant.price | money -}}
            {%- if section.settings.price_suffix != blank %} / {{ section.settings.price_suffix | escape }}{%- endif -%}
          </p>
        {%- endif -%}
      </div>
    </div>

    <button class="satc__btn" type="button" id="satc-btn-{{ section.id }}">
      {{ section.settings.button_text | escape }}
    </button>

  </div>
</div>

<script>
  (function () {
    var bar     = document.getElementById('satc-{{ section.id }}');
    var stickyBtn = document.getElementById('satc-btn-{{ section.id }}');
    var priceEl   = document.getElementById('satc-price-{{ section.id }}');
    if (!bar || !stickyBtn) return;

    /* ── 1. Show / hide ─────────────────────────────────────── */
    var mainAddBtn = document.querySelector('product-form [name="add"]');
    if (mainAddBtn) {
      var io = new IntersectionObserver(function (entries) {
        var outOfView = !entries[0].isIntersecting;
        bar.classList.toggle('is-visible', outOfView);
        bar.setAttribute('aria-hidden', String(!outOfView));
      }, { threshold: 0 });
      io.observe(mainAddBtn);
    }

    /* ── 2. Mirror disabled state ───────────────────────────── */
    function syncDisabled() {
      if (!mainAddBtn) return;
      stickyBtn.disabled = mainAddBtn.disabled;
    }
    if (mainAddBtn) {
      new MutationObserver(syncDisabled).observe(mainAddBtn, { attributes: true, attributeFilter: ['disabled'] });
      syncDisabled();
    }

    /* ── 3. Add to cart — proxy click to main form ──────────── */
    stickyBtn.addEventListener('click', function () {
      var btn = document.querySelector('product-form [name="add"]');
      if (btn && !btn.disabled) btn.click();
    });

    /* ── 4. Price sync (optional) ───────────────────────────── */
    {%- if section.settings.show_price -%}
    var allVariants   = {{ product.variants | json }};
    var moneyFormat   = {{ shop.money_format | json }};
    var priceSuffix   = {{ section.settings.price_suffix | json }};

    function formatMoney(cents) {
      var n = (cents / 100).toFixed(2);
      return moneyFormat
        .replace(/\{\{amount\}\}/g, n)
        .replace(/\{\{amount_no_decimals\}\}/g, Math.round(cents / 100))
        .replace(/\{\{amount_with_comma_separator\}\}/g, n.replace('.', ','))
        .replace(/\{\{amount_no_decimals_with_comma_separator\}\}/g,
                 String(Math.round(cents / 100)).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    function updatePrice() {
      var input = document.querySelector('product-form [name="id"]');
      if (!input || !priceEl) return;
      var id = parseInt(input.value, 10);
      var variant = allVariants.find(function (v) { return v.id === id; });
      if (!variant) return;
      var text = formatMoney(variant.price);
      if (priceSuffix) text += ' / ' + priceSuffix;
      priceEl.textContent = text;
    }

    /* listen on the product form for any input/change events */
    var productForm = document.querySelector('product-form');
    if (productForm) productForm.addEventListener('change', updatePrice);

    /* fallback: also watch variant-selects */
    var variantSelects = document.querySelector('variant-selects');
    if (variantSelects) variantSelects.addEventListener('change', updatePrice);
    {%- endif -%}

  })();
</script>

{%- endif -%}

{% schema %}
{
  "name": "Sticky Add to Cart",
  "tag": "section",
  "class": "sticky-atc-section",
  "limit": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable sticky bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product thumbnail",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price line",
      "default": true
    },
    {
      "type": "text",
      "id": "price_suffix",
      "label": "Price suffix",
      "default": "Subscribe & Save",
      "info": "Appended after the price, e.g. \"Subscribe & Save\". Leave blank to show price only."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add to Cart"
    },
    {
      "type": "header",
      "content": "Fonts"
    },
    {
      "type": "select",
      "id": "name_font",
      "label": "Product name font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
    },
    {
      "type": "select",
      "id": "price_font",
      "label": "Price font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
    },
    {
      "type": "select",
      "id": "btn_font",
      "label": "Button font",
      "options": [
        { "value": "--font-tag-family",     "label": "PP Neue Montreal Mono" },
        { "value": "--font-heading-family", "label": "D-DIN" },
        { "value": "--font-accent-family",  "label": "Alkaline Test" }
      ],
      "default": "--font-heading-family"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Bar background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "navy_color",
      "label": "Product name color",
      "default": "#232748"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Price line color",
      "default": "#c39a4e"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button color",
      "default": "#ef4d24"
    },
    {
      "type": "color",
      "id": "btn_hover_color",
      "label": "Button hover color",
      "default": "#dc411b"
    },
    {
      "type": "text",
      "id": "bar_label",
      "label": "Bar aria-label",
      "default": "Sticky add to cart"
    }
  ],
  "presets": [
    {
      "name": "Sticky Add to Cart"
    }
  ]
}
{% endschema %}
