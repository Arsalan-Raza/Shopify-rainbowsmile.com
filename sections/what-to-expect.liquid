{%- style -%}
  #shopify-section-{{ section.id }} {
    --wt-navy:   {{ section.settings.navy_color }};
    --wt-coral:  {{ section.settings.coral_color }};
    --wt-green:  {{ section.settings.green_color }};
    --wt-body:   {{ section.settings.body_color }};
    --wt-line:   {{ section.settings.line_color }};
    --wt-circle: {{ section.settings.circle_color }};
    --wt-imgbg:  {{ section.settings.imgbg_color }};

    background: {{ section.settings.bg_color }};
    padding-block: clamp(44px, 6vw, 84px);
    padding-inline: clamp(20px, 5vw, 56px);
  }

  .wte-{{ section.id }} * { box-sizing: border-box; }

  .wte-{{ section.id }} {
    max-width: 1320px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  /* ── Left: header ───────────────────────────────────────────── */
  .wte-{{ section.id }} .wte__eyebrow {
    margin: 0 0 clamp(16px, 2.2vw, 22px);
    font-family: var(--font-tag-family);
    font-weight: 700;
    font-size: clamp(16px, 1.1vw, 17px);
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--wt-coral);
    line-height: 1;
  }
  .wte-{{ section.id }} .wte__title {
    margin: 0 0 clamp(28px, 4vw, 48px);
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: clamp(38px, 5.2vw, 68px);
    line-height: 1.0;
    letter-spacing: -1px;
    color: var(--wt-navy);
  }
  .wte-{{ section.id }} .wte__script {
    font-family: var(--font-accent-family);
    font-weight: 400;
    font-size: 0.94em;
    letter-spacing: 0;
    color: var(--wt-coral);
    margin-left: 10px;
  }

  /* ── Stages ─────────────────────────────────────────────────── */
  .wte-{{ section.id }} .wte__stage {
    display: grid;
    grid-template-columns: clamp(56px, 6vw, 72px) 1fr;
    gap: clamp(18px, 2.4vw, 28px);
    padding-block: clamp(22px, 3vw, 32px);
    border-top: 1px solid var(--wt-line);
  }
  .wte-{{ section.id }} .wte__stage:first-of-type { border-top: none; padding-top: 0; }

  .wte-{{ section.id }} .wte__icon {
    width: clamp(56px, 6vw, 72px);
    height: clamp(56px, 6vw, 72px);
    flex: none;
    border-radius: 50%;
    background: var(--wt-circle);
    display: grid;
    place-items: center;
    color: var(--wt-green);
  }
  .wte-{{ section.id }} .wte__icon svg {
    width: 46%;
    height: 46%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wte-{{ section.id }} .wte__day {
    margin: 0 0 10px;
    font-family: var(--font-tag-family);
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--wt-green);
    line-height: 1;
  }
  .wte-{{ section.id }} .wte__stage-title {
    margin: 0 0 clamp(10px, 1.4vw, 14px);
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(20px, 1.9vw, 26px);
    line-height: 1.25;
    color: var(--wt-navy);
  }
  .wte-{{ section.id }} .wte__stage-body {
    margin: 0;
    max-width: 560px;
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.65;
    color: var(--wt-body);
  }

  /* ── Right: product image ────────────────────────────────────── */
  .wte-{{ section.id }} .wte__media {
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--wt-imgbg);
  }
  .wte-{{ section.id }} .wte__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 899px) {
    .wte-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: clamp(30px, 6vw, 44px);
    }
    .wte-{{ section.id }} .wte__media {
      order: -1;
      max-width: 460px;
      margin-inline: auto;
      width: 100%;
    }
    .wte-{{ section.id }} .wte__title { margin-bottom: clamp(24px, 5vw, 34px); }
  }
{%- endstyle -%}

<div class="wte-{{ section.id }}">

  <!-- Left: content -->
  <div class="wte__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="wte__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="wte__title">
        {{- section.settings.title | escape -}}
        {%- if section.settings.script != blank -%}
          <span class="wte__script">{{ section.settings.script | escape }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'stage' -%}
        <div class="wte__stage" {{ block.shopify_attributes }}>
          <span class="wte__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'plant' -%}
                <svg viewBox="0 0 32 32"><path d="M16 28v-9"/><path d="M16 19c0-3.5-2.5-6-6-6-.5 0 0 4 2 5.5S16 21 16 19Z"/><path d="M16 20c0-4 2.8-6.5 6.5-6.5.5 0 0 4.5-2.2 6S16 22 16 20Z"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 32 32"><path d="M8 24C13 24 20 20 22 10"/><path d="M22 10c-3 .3-5 1.5-6 3.5M22 10c-.3 3-1.5 5-3.5 6M17 16c-2.8.3-4.6 1.6-5.5 3.6M17 16c-.4 2.8-1.7 4.6-3.7 5.5"/></svg>
              {%- when 'flower' -%}
                <svg viewBox="0 0 32 32"><path d="M16 28v-6"/><path d="M16 22a7 7 0 1 0-4.5-1.6A6 6 0 0 0 16 22Z"/><path d="M12 14.5c1-1.5 2.4-2.2 4-2.2s3 .7 4 2.2"/></svg>
              {%- when 'drop' -%}
                <svg viewBox="0 0 32 32"><path d="M16 6c0 0-8 7.5-8 13a8 8 0 0 0 16 0C24 13.5 16 6 16 6Z"/><path d="M11 21a5 5 0 0 0 3.5 4"/></svg>
              {%- when 'sun' -%}
                <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="5"/><path d="M16 4v3M16 25v3M4 16h3M25 16h3M7.5 7.5l2.1 2.1M22.4 22.4l2.1 2.1M7.5 24.5l2.1-2.1M22.4 9.6l2.1-2.1"/></svg>
              {%- when 'sparkle' -%}
                <svg viewBox="0 0 32 32"><path d="M16 4l2 8 8 2-8 2-2 8-2-8-8-2 8-2 2-8Z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="8"/><path d="M16 12v4l3 3"/></svg>
            {%- endcase -%}
          </span>
          <div>
            {%- if block.settings.day != blank -%}
              <p class="wte__day">{{ block.settings.day | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="wte__stage-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="wte__stage-body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <!-- Right: image -->
  <div class="wte__media">
    {%- if section.settings.image != blank -%}
      {%- assign img_alt = section.settings.image.alt | escape -%}
      {{- section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: img_alt -}}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "What to Expect",
  "tag": "section",
  "class": "what-to-expect-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Results Timeline"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What to"
    },
    {
      "type": "text",
      "id": "script",
      "label": "Script word (inline, coral)",
      "default": "expect."
    },
    {
      "type": "header",
      "content": "Product Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "navy_color",
      "label": "Headings",
      "default": "#232748"
    },
    {
      "type": "color",
      "id": "coral_color",
      "label": "Eyebrow & script",
      "default": "#ef4a22"
    },
    {
      "type": "color",
      "id": "green_color",
      "label": "Day labels & icons",
      "default": "#3fae54"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#55586b"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Stage dividers",
      "default": "#ece7de"
    },
    {
      "type": "color",
      "id": "circle_color",
      "label": "Icon circle background",
      "default": "#f3ecd4"
    },
    {
      "type": "color",
      "id": "imgbg_color",
      "label": "Image card background",
      "default": "#f2efe6"
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "plant",   "label": "Plant / sprout" },
            { "value": "leaf",    "label": "Leaf / branching" },
            { "value": "flower",  "label": "Flower / bloom" },
            { "value": "drop",    "label": "Water drop" },
            { "value": "sun",     "label": "Sun" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "plant"
        },
        {
          "type": "text",
          "id": "day",
          "label": "Day / time label",
          "default": "Days 1–3"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Stage title",
          "default": "Immediate freshness"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Description",
          "default": "A noticeably cleaner feeling after use. The formulation is working immediately."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What to Expect",
      "blocks": [
        {
          "type": "stage",
          "settings": {
            "icon": "plant",
            "day": "Days 1–3",
            "title": "Immediate freshness",
            "body": "A noticeably cleaner feeling after use. The formulation is working immediately — restoring oxygen to the oral environment with each application."
          }
        },
        {
          "type": "stage",
          "settings": {
            "icon": "leaf",
            "day": "Days 4–14",
            "title": "Sustained freshness builds",
            "body": "As the aerobic community re-establishes itself, many people notice a sustained freshness that persists between uses. Morning breath begins to change."
          }
        },
        {
          "type": "stage",
          "settings": {
            "icon": "flower",
            "day": "Weeks 3–4 and Beyond",
            "title": "The ecology is restoring",
            "body": "The freshness becomes the baseline rather than the exception. Individual results vary — the ecology works at its own pace. Consistent daily use is key."
          }
        }
      ]
    }
  ]
}
{% endschema %}
