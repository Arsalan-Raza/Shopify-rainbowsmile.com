{%- style -%}
  #shopify-section-{{ section.id }} {
    --bh-green-1: {{ section.settings.green1_color }};
    --bh-green-2: {{ section.settings.green2_color }};
    --bh-navy:    {{ section.settings.navy_color }};
    --bh-white:   {{ section.settings.white_color }};
    --bh-gold:    {{ section.settings.gold_color }};
    --bh-coral:   {{ section.settings.coral_color }};
    --bh-curve:   {{ section.settings.curve_color }};
    --bh-eyebrow: rgba(255, 255, 255, 0.55);
    --bh-body:    rgba(255, 255, 255, 0.9);
    --bh-pill:    rgba(245, 184, 66, 0.5);
  }
  {%- if section.settings.bg_image != blank -%}
    #shopify-section-{{ section.id }} .bhero {
      background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
    }
  {%- endif -%}
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .bhero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--bh-navy);
    background-size: cover;
    background-position: center;
    padding: clamp(44px, 7vw, 88px) clamp(20px, 5vw, 72px) clamp(70px, 9vw, 120px);
  }

  #shopify-section-{{ section.id }} .bhero__inner {
    position: relative;
    z-index: 2;
    max-width: 1265px;
    margin-inline: auto;
  }

  {% comment %} #shopify-section-{{ section.id }} .bhero__content { max-width: 780px; } {% endcomment %}

  /* ---------- Eyebrow ---------- */
  #shopify-section-{{ section.id }} .bhero__eyebrow {
    margin: 0 0 clamp(18px, 2.6vw, 26px);
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 400;
    font-size: clamp(12px, 1.05vw, 13px);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--bh-eyebrow);
    line-height: 1;
  }

  /* ---------- Headline ---------- */
  #shopify-section-{{ section.id }} .bhero__title {
    margin: 0;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 800;
    font-size: clamp(40px, 6.4vw, 82px);
    line-height: 1.0;
    letter-spacing: -1.5px;
    color: var(--bh-white);
  }
  #shopify-section-{{ section.id }} .bhero__script {
    display: block;
    margin-top: clamp(4px, 0.8vw, 10px);
    font-family: var(--font-{{ section.settings.script_font }}-family);
    font-weight: 400;
    font-size: clamp(38px, 5.6vw, 74px);
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--bh-gold);
  }

  /* ---------- Coral rule ---------- */
  #shopify-section-{{ section.id }} .bhero__rule {
    width: 64px;
    height: 3px;
    margin: clamp(20px, 3vw, 30px) 0 clamp(22px, 3vw, 30px);
    background: var(--bh-coral);
    border: none;
  }

  /* ---------- Subtitle ---------- */
  #shopify-section-{{ section.id }} .bhero__sub {
    margin: 0;
    max-width: 660px;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(15px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--bh-body);
  }
  #shopify-section-{{ section.id }} .bhero__sub p { margin: 0; }

  /* ---------- Pills ---------- */
  #shopify-section-{{ section.id }} .bhero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(10px, 1.2vw, 14px);
    margin: clamp(26px, 3.6vw, 40px) 0 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .bhero__pill {
    display: inline-flex;
    align-items: center;
    padding: 9px 13px;
    min-height: 40px;
    border-radius: 999px;
    border: 1px solid var(--bh-pill);
    font-family: var(--font-tag-family);
    font-weight: 400;
    font-size: clamp(11px, 1.05vw, 13px);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--bh-gold);
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .bhero__pill sup {
    font-size: 0.7em;
    vertical-align: super;
  }

  /* ---------- Bottom curve ---------- */
  #shopify-section-{{ section.id }} .bhero__curve {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(34px, 5vw, 62px);
    z-index: 3;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .bhero__curve svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ section.id }} .bhero__curve svg path { fill: var(--bh-curve); }

  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .bhero__title { letter-spacing: -0.5px; }
    #shopify-section-{{ section.id }} .bhero__pills { gap: 8px; }
    #shopify-section-{{ section.id }} .bhero__pill { padding: 9px 15px; letter-spacing: 0.6px; }
  }
</style>

<section class="bhero">
  <div class="bhero__inner">
    <div class="bhero__content">

      {%- if section.settings.eyebrow != blank -%}
        <p class="bhero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank or section.settings.script_line != blank -%}
        <h1 class="bhero__title">
          {{- section.settings.title | escape -}}
          {%- if section.settings.script_line != blank -%}
            <span class="bhero__script">{{ section.settings.script_line | escape }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      <hr class="bhero__rule">

      {%- if section.settings.subtitle != blank -%}
        <div class="bhero__sub">{{ section.settings.subtitle }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="bhero__pills">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <li class="bhero__pill" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

    </div>
  </div>

  {%- if section.settings.show_curve -%}
    <div class="bhero__curve" aria-hidden="true">
      <svg viewBox="0 0 1440 56" preserveAspectRatio="none">
        <path d="M0,56 L1440,56 L1440,46 Q720,-28 0,46 Z"/>
      </svg>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Community Hero",
  "tag": "section",
  "class": "community-hero-section",
  "blocks": [
    {
      "type": "pill",
      "name": "Pill tag",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Pill text",
          "info": "You can include ™ or ® characters directly in this field."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "info": "Overlays the gradient. Recommended: dark, wide image."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rainbow Smile \u00b7 The Biome Hacker Community"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading (white part)",
      "default": "You already sensed it."
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script line (gold, below heading)",
      "default": "Welcome home."
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>The community for people who think of their body as a living ecosystem \u2014 and are done accepting the wrong answers for it.<\/p>"
    },
    {
      "type": "header",
      "content": "Bottom Curve"
    },
    {
      "type": "checkbox",
      "id": "show_curve",
      "label": "Show bottom curve",
      "default": true
    },
    {
      "type": "color",
      "id": "curve_color",
      "label": "Curve color (match section below)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Fonts"
    },
    {
      "type": "select",
      "id": "mono_font",
      "label": "Eyebrow & pill font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "tag"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "script_font",
      "label": "Script line font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "accent"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Subtitle font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "green1_color",
      "label": "Gradient start (top-left)",
      "default": "#3f9a4a"
    },
    {
      "type": "color",
      "id": "green2_color",
      "label": "Gradient mid",
      "default": "#2f7d3f"
    },
    {
      "type": "color",
      "id": "navy_color",
      "label": "Gradient end (bottom-right)",
      "default": "#232a4d"
    },
    {
      "type": "color",
      "id": "white_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Script & pill color",
      "default": "#f5b842"
    },
    {
      "type": "color",
      "id": "coral_color",
      "label": "Rule color",
      "default": "#ef4a22"
    }
  ],
  "presets": [
    {
      "name": "Community Hero",
      "blocks": [
        { "type": "pill", "settings": { "text": "Oral Microbiome Aware" } },
        { "type": "pill", "settings": { "text": "Quorum Sensing Literate" } },
        { "type": "pill", "settings": { "text": "Rejects Antiseptic Thinking" } },
        { "type": "pill", "settings": { "text": "Body as Ecosystem" } },
        { "type": "pill", "settings": { "text": "Science and Spirit" } },
        { "type": "pill", "settings": { "text": "Love Serves All\u2122" } }
      ]
    }
  ]
}
{% endschema %}
