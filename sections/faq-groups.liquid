{%- style -%}
  #shopify-section-{{ section.id }} {
    --gf-navy:   {{ section.settings.navy_color }};
    --gf-body:   {{ section.settings.body_color }};
    --gf-accent: {{ section.settings.accent_color }};
    --gf-peach:  {{ section.settings.peach_color }};
    --gf-gold:   {{ section.settings.gold_color }};
    --gf-line:   {{ section.settings.line_color }};
    --gf-sub:    {{ section.settings.sub_color }};

    background: {{ section.settings.bg_color }};
    padding-block: clamp(44px, 6vw, 80px);
    padding-inline: clamp(20px, 5vw, 40px);
  }

  .gfaq-{{ section.id }} * { box-sizing: border-box; }

  .gfaq-{{ section.id }} .gfaq__inner {
    max-width: 720px;
    margin-inline: auto;
  }

  /* ---------- Category group ---------- */
  .gfaq-{{ section.id }} .gfaq__group { margin-bottom: clamp(40px, 6vw, 64px); }
  .gfaq-{{ section.id }} .gfaq__group:last-of-type { margin-bottom: 0; }

  .gfaq-{{ section.id }} .gfaq__group-title {
    margin: 0 0 clamp(16px, 2.4vw, 24px);
    text-align: center;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 800;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: var(--gf-navy);
  }
  .gfaq-{{ section.id }} .gfaq__group-title small {
    font-weight: 700;
    font-size: 0.42em;
    color: var(--gf-sub);
    margin-left: 6px;
    letter-spacing: 0;
  }

  /* ---------- Accordion ---------- */
  .gfaq-{{ section.id }} .gfaq__item { border-bottom: 1px solid var(--gf-line); }

  .gfaq-{{ section.id }} .gfaq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }
  .gfaq-{{ section.id }} .gfaq__summary::-webkit-details-marker { display: none; }
  .gfaq-{{ section.id }} .gfaq__summary:focus-visible {
    outline: 3px solid rgba(244, 80, 43, 0.35);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .gfaq-{{ section.id }} .gfaq__q {
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 700;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.3;
    color: var(--gf-navy);
  }
  .gfaq-{{ section.id }} .gfaq__q sup { font-size: 0.62em; vertical-align: super; }

  /* + / − icon */
  .gfaq-{{ section.id }} .gfaq__icon {
    position: relative;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    background: var(--gf-peach);
  }
  .gfaq-{{ section.id }} .gfaq__icon::before,
  .gfaq-{{ section.id }} .gfaq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--gf-accent);
    transform: translate(-50%, -50%);
  }
  .gfaq-{{ section.id }} .gfaq__icon::before { width: 13px; height: 2px; }
  .gfaq-{{ section.id }} .gfaq__icon::after  { width: 2px; height: 13px; transition: transform 0.2s ease; }
  .gfaq-{{ section.id }} .gfaq__item[open] .gfaq__icon::after { transform: translate(-50%, -50%) scaleY(0); }

  /* Answer */
  .gfaq-{{ section.id }} .gfaq__answer { padding: 0 0 24px; max-width: 100%; }
  .gfaq-{{ section.id }} .gfaq__answer p {
    margin: 0;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(16px, 1.3vw, 17px);
    line-height: 1.65;
    color: var(--gf-body);
  }
  .gfaq-{{ section.id }} .gfaq__item[open] .gfaq__answer { animation: gfaqOpen-{{ section.id }} 0.25s ease; }
  @keyframes gfaqOpen-{{ section.id }} {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }

  /* ---------- CTA ---------- */
  .gfaq-{{ section.id }} .gfaq__cta-wrap { text-align: center; margin-top: clamp(40px, 6vw, 64px); }
  .gfaq-{{ section.id }} .gfaq__cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 18px 38px;
    min-height: 56px;
    border-radius: 999px;
    background: var(--gf-gold);
    color: var(--gf-navy);
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 700;
    font-size: clamp(16px, 1.3vw, 17px);
    text-decoration: none;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }
  .gfaq-{{ section.id }} .gfaq__cta span { transition: transform 0.18s ease; }
  @media (hover: hover) {
    .gfaq-{{ section.id }} .gfaq__cta:hover { background: #ecac2c; transform: translateY(-2px); }
    .gfaq-{{ section.id }} .gfaq__cta:hover span { transform: translateX(3px); }
  }
  .gfaq-{{ section.id }} .gfaq__cta:focus-visible { outline: 3px solid rgba(245, 183, 49, 0.5); outline-offset: 3px; }

  @media (max-width: 480px) {
    .gfaq-{{ section.id }} .gfaq__icon { width: 32px; height: 32px; }
    .gfaq-{{ section.id }} .gfaq__cta { width: 100%; justify-content: center; }
    .gfaq-{{ section.id }} .gfaq__group-title small { display: block; margin: 4px 0 0; font-size: 0.34em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gfaq-{{ section.id }} .gfaq__cta:hover { transform: none; }
    .gfaq-{{ section.id }} .gfaq__cta span { transition: none; }
  }
{%- endstyle -%}

<div class="gfaq-{{ section.id }}">
  <div class="gfaq__inner">

    {%- liquid
      assign has_open_group = false
    -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        {%- if has_open_group -%}</div>{%- endif -%}
        <div class="gfaq__group" {{ block.shopify_attributes }}>
          <h2 class="gfaq__group-title">
            {{- block.settings.title | escape -}}
            {%- if block.settings.subtitle != blank -%}
              <small>{{ block.settings.subtitle | escape }}</small>
            {%- endif -%}
          </h2>
        {%- assign has_open_group = true -%}

      {%- elsif block.type == 'qa' -%}
        {%- unless has_open_group -%}
          <div class="gfaq__group">
          {%- assign has_open_group = true -%}
        {%- endunless -%}
        <details class="gfaq__item" {{ block.shopify_attributes }}>
          <summary class="gfaq__summary">
            <span class="gfaq__q">{{ block.settings.question }}</span>
            <span class="gfaq__icon" aria-hidden="true"></span>
          </summary>
          <div class="gfaq__answer">
            {{ block.settings.answer }}
          </div>
        </details>

      {%- endif -%}
    {%- endfor -%}

    {%- if has_open_group -%}</div>{%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="gfaq__cta-wrap">
        <a class="gfaq__cta" href="{{ section.settings.cta_url | default: '#' }}">
          {{ section.settings.cta_text | escape }}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "FAQ Groups",
  "tag": "section",
  "class": "faq-groups-section",
  "settings": [
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Still have more Questions"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Fonts"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading & question font",
      "options": [
        {
          "value": "tag",
          "label": "PP Neue Montreal Mono"
        },
        {
          "value": "heading",
          "label": "D-DIN"
        },
        {
          "value": "accent",
          "label": "Alkaline Test"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Answer font",
      "options": [
        {
          "value": "tag",
          "label": "PP Neue Montreal Mono"
        },
        {
          "value": "heading",
          "label": "D-DIN"
        },
        {
          "value": "accent",
          "label": "Alkaline Test"
        }
      ],
      "default": "heading"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "navy_color",
      "label": "Heading & question color",
      "default": "#232748"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Answer text color",
      "default": "#4b4f63"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon color",
      "default": "#f4502b"
    },
    {
      "type": "color",
      "id": "peach_color",
      "label": "Icon circle background",
      "default": "#fce6da"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "CTA button color",
      "default": "#f5b731"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Divider line color",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Category subtitle color",
      "default": "#6b7088"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Shipping"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (optional, shown smaller)",
          "info": "e.g. \"how to use the products\""
        }
      ]
    },
    {
      "type": "qa",
      "name": "Question & Answer",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Groups",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Shipping"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Do you ship overseas?",
            "answer": "<p>Yes — we ship worldwide. Delivery times and duties vary by destination; you'll see exact options and costs at checkout.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "How long will it take to get my orders?",
            "answer": "<p>Domestic orders typically arrive in 3–5 business days. International delivery usually takes 7–14 business days depending on the carrier.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Returns & Refunds"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Your question here?",
            "answer": "<p>Your answer here.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Safety & Ingredients"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "What is OG3™?",
            "answer": "<p>OG3™ is our oxygen-rich oral care formula, designed to support the oral-gut axis with bioavailable oxygen and plant-based compounds.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
