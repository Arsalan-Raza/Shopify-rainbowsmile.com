        {
          "type": "text",
          "id": "poster_alt",
          "label": "Poster alt text"
        },
        {
          "type": "header",
          "content": "Quote"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Pull quote",
          "default": "\u201cI didn\u2019t learn something new. I remembered something I always knew.\u201d"
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Attribution",
          "default": "Biome Hacker \u00b7 OG3\u2122 Community Member"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
