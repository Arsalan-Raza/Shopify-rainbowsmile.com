{%- style -%}
  #shopify-section-{{ section.id }} {
    --cr-navy:     {{ section.settings.navy_color }};
    --cr-accent:   {{ section.settings.accent_color }};
    --cr-body:     {{ section.settings.body_color }};
    --cr-icon:     {{ section.settings.icon_color }};
    --cr-trust:    {{ section.settings.trust_label_color }};
    --cr-trust-bg: {{ section.settings.trust_bg_color }};
    --cr-line:     {{ section.settings.line_color }};

    background: {{ section.settings.bg_color }};
    padding-block: clamp(44px, 6vw, 80px);
    padding-inline: clamp(16px, 4vw, 48px);
  }

  .cred-{{ section.id }} * { box-sizing: border-box; }
  .cred-{{ section.id }} .cred__inner { max-width: 1280px; margin-inline: auto; }

  /* ── Header ──────────────────────────────────────────────── */
  .cred-{{ section.id }} .cred__head {
    text-align: center;
    margin-bottom: clamp(32px, 4.5vw, 54px);
  }
  .cred-{{ section.id }} .cred__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 700;
    font-size: clamp(14px, 1.1vw, 15px);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--cr-accent);
    line-height: 1;
  }
  .cred-{{ section.id }} .cred__eyebrow::before {
    content: "";
    width: 24px;
    height: 2px;
    background: currentColor;
    flex: none;
  }
  .cred-{{ section.id }} .cred__title {
    margin: 0;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 800;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.02;
    letter-spacing: -0.5px;
    color: var(--cr-navy);
  }
  .cred-{{ section.id }} .cred__script {
    display: block;
    margin-top: 2px;
    font-family: var(--font-{{ section.settings.script_font }}-family);
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.1;
    color: var(--cr-accent);
  }
  /* ── Mosaic ──────────────────────────────────────────────── */
  .cred-{{ section.id }} .cred__mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-areas:
      "t1 i1 t2"
      "i2 t3 i3";
    gap: clamp(16px, 1.8vw, 24px);
    margin-bottom: clamp(28px, 3.6vw, 44px);
  }
  .cred-{{ section.id }} .cred__tile { border-radius: 18px; overflow: hidden; }

  /* Text tiles */
  .cred-{{ section.id }} .cred__tile--text {
    padding: clamp(26px, 3vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .cred-{{ section.id }} .cred__tile--t1 { grid-area: t1; background: {{ section.settings.tile1_bg }}; }
  .cred-{{ section.id }} .cred__tile--t2 { grid-area: t2; background: {{ section.settings.tile2_bg }}; }
  .cred-{{ section.id }} .cred__tile--t3 { grid-area: t3; background: {{ section.settings.tile3_bg }}; }
  .cred-{{ section.id }} .cred__icon {
    font-size: 34px;
    line-height: 1;
    margin-bottom: clamp(20px, 3vw, 34px);
  }
  .cred-{{ section.id }} .cred__tile-title {
    margin: 0 0 14px;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.2;
    color: var(--cr-navy);
  }
  .cred-{{ section.id }} .cred__tile-body {
    margin: 0;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.65;
    color: var(--cr-body);
  }
  .cred-{{ section.id }} .cred__tile-body p { margin: 0; }
  .cred-{{ section.id }} .cred__tile-body sup { font-size: 0.62em; vertical-align: super; }

  /* Image tiles */
  .cred-{{ section.id }} .cred__tile--img {
    position: relative;
    min-height: 340px;
    background: linear-gradient(160deg, #e6ddd0, #f3ece1);
  }
  .cred-{{ section.id }} .cred__tile--img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cred-{{ section.id }} .cred__tile--i1 { grid-area: i1; }
  .cred-{{ section.id }} .cred__tile--i2 { grid-area: i2; }
  .cred-{{ section.id }} .cred__tile--i3 { grid-area: i3; }

  /* ── Trust bar ───────────────────────────────────────────── */
  .cred-{{ section.id }} .cred__trust {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    background: var(--cr-trust-bg);
    border-radius: 16px;
    padding-block: clamp(18px, 2vw, 24px);
  }
  .cred-{{ section.id }} .cred__trust-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 6px clamp(8px, 1.4vw, 18px);
    border-left: 1px solid var(--cr-line);
  }
  .cred-{{ section.id }} .cred__trust-item:nth-child(6n+1) { border-left: none; }
  .cred-{{ section.id }} .cred__trust-icon { color: var(--cr-icon); flex: none; }
  .cred-{{ section.id }} .cred__trust-icon svg { width: 30px; height: 30px; display: block; }
  .cred-{{ section.id }} .cred__trust-label {
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 400;
    font-size: clamp(14px, 1.1vw, 15px);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--cr-trust);
    white-space: nowrap;
  }
  .cred-{{ section.id }} .cred__trust-label sup { font-size: 0.7em; vertical-align: super; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media screen and (max-width: 979px) {
    .cred-{{ section.id }} .cred__mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "t1 i1"
        "t2 i3"
        "i2 t3";
    }
    .cred-{{ section.id }} .cred__tile--img { min-height: 300px; }
    .cred-{{ section.id }} .cred__trust { grid-template-columns: repeat(3, 1fr); row-gap: 4px; }
    .cred-{{ section.id }} .cred__trust-item:nth-child(n)    { border-left: 1px solid var(--cr-line); }
    .cred-{{ section.id }} .cred__trust-item:nth-child(3n+1) { border-left: none; }
  }
  @media screen and (max-width: 640px) {
    .cred-{{ section.id }} .cred__mosaic {
      grid-template-columns: 1fr;
      grid-template-areas: "t1" "i1" "t2" "i3" "t3" "i2";
    }
    .cred-{{ section.id }} .cred__tile--img { min-height: 260px; }
    .cred-{{ section.id }} .cred__trust {
      display: flex;
      flex-wrap: wrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-block: clamp(14px, 2vw, 20px);
      border-radius: 16px;
      flex-direction: column;
    }
    .cred-{{ section.id }} .cred__trust::-webkit-scrollbar { display: none; }
    .cred-{{ section.id }} .cred__trust-item {
      flex: none;
      flex-direction: column;
      gap: 8px;
      padding: 6px clamp(16px, 4vw, 24px);
      border-left: 1px solid var(--cr-line);
      border-top: none;
    }
    .cred-{{ section.id }} .cred__trust-item:first-child { border-left: none; }
  }
{%- endstyle -%}

<div class="cred-{{ section.id }}">
  <div class="cred__inner">

    <header class="cred__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cred__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank or section.settings.script_line != blank -%}
        <h2 class="cred__title">
          {{- section.settings.title | escape -}}
          {%- if section.settings.script_line != blank -%}
            <span class="cred__script">{{ section.settings.script_line | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
    </header>

    <div class="cred__mosaic">

      <!-- t1 -->
      <div class="cred__tile cred__tile--text cred__tile--t1">
        {%- if section.settings.tile1_icon != blank -%}
          <span class="cred__icon" aria-hidden="true">{{ section.settings.tile1_icon }}</span>
        {%- endif -%}
        {%- if section.settings.tile1_title != blank -%}
          <h3 class="cred__tile-title">{{ section.settings.tile1_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.tile1_body != blank -%}
          <div class="cred__tile-body">{{ section.settings.tile1_body }}</div>
        {%- endif -%}
      </div>

      <!-- i1 -->
      <div class="cred__tile cred__tile--img cred__tile--i1">
        {%- if section.settings.image1 != blank -%}
          {%- assign img1_alt = section.settings.image1.alt | default: section.settings.image1_alt | escape -%}
          {{
            section.settings.image1
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              alt: img1_alt,
              widths: '450, 700, 900'
          }}
        {%- endif -%}
      </div>

      <!-- t2 -->
      <div class="cred__tile cred__tile--text cred__tile--t2">
        {%- if section.settings.tile2_icon != blank -%}
          <span class="cred__icon" aria-hidden="true">{{ section.settings.tile2_icon }}</span>
        {%- endif -%}
        {%- if section.settings.tile2_title != blank -%}
          <h3 class="cred__tile-title">{{ section.settings.tile2_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.tile2_body != blank -%}
          <div class="cred__tile-body">{{ section.settings.tile2_body }}</div>
        {%- endif -%}
      </div>

      <!-- i2 -->
      <div class="cred__tile cred__tile--img cred__tile--i2">
        {%- if section.settings.image2 != blank -%}
          {%- assign img2_alt = section.settings.image2.alt | default: section.settings.image2_alt | escape -%}
          {{
            section.settings.image2
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              alt: img2_alt,
              widths: '450, 700, 900'
          }}
        {%- endif -%}
      </div>

      <!-- t3 -->
      <div class="cred__tile cred__tile--text cred__tile--t3">
        {%- if section.settings.tile3_icon != blank -%}
          <span class="cred__icon" aria-hidden="true">{{ section.settings.tile3_icon }}</span>
        {%- endif -%}
        {%- if section.settings.tile3_title != blank -%}
          <h3 class="cred__tile-title">{{ section.settings.tile3_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.tile3_body != blank -%}
          <div class="cred__tile-body">{{ section.settings.tile3_body }}</div>
        {%- endif -%}
      </div>

      <!-- i3 -->
      <div class="cred__tile cred__tile--img cred__tile--i3">
        {%- if section.settings.image3 != blank -%}
          {%- assign img3_alt = section.settings.image3.alt | default: section.settings.image3_alt | escape -%}
          {{
            section.settings.image3
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              alt: img3_alt,
              widths: '450, 700, 900'
          }}
        {%- endif -%}
      </div>

    </div>

    <!-- Trust bar -->
    {%- if section.blocks.size > 0 -%}
      <div class="cred__trust">
        {%- for block in section.blocks -%}
          <span class="cred__trust-item" {{ block.shopify_attributes }}>
            <span class="cred__trust-icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'vegan' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20c0-7 5-12 11-12 0 6-4 11-11 12Z"/><path d="M4 20c2.5-4 5.5-6.5 9-8"/></svg>
                {%- when 'cruelty_free' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9c-1.6-1.4-2-4-1.2-5.4C7.7 2.2 9.4 4.4 9.8 7"/><path d="M16 9c1.6-1.4 2-4 1.2-5.4C16.3 2.2 14.6 4.4 14.2 7"/><path d="M12 8a5.5 5.5 0 0 1 5.5 5.5c0 3.6-2.5 6.5-5.5 6.5s-5.5-2.9-5.5-6.5A5.5 5.5 0 0 1 12 8Z"/><circle cx="10.2" cy="14" r=".8" fill="currentColor" stroke="none"/><circle cx="13.8" cy="14" r=".8" fill="currentColor" stroke="none"/></svg>
                {%- when 'regenerative' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 6.5 9.6 3l2.6 4.4"/><path d="M4.5 15 3 11.2l4.6-1.6"/><path d="M16.6 5.6 19 9.4l-4.4 1.8"/><path d="M20 15.5 17.4 20H12"/><path d="M8 20H5.5l1.2-4.5"/><path d="M12 20l2-2.6-3.4-1"/></svg>
                {%- when 'science' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3h4"/><path d="M11 3v6.2L5.6 18a2 2 0 0 0 1.7 3h9.4a2 2 0 0 0 1.7-3L13 9.2V3"/><path d="M7.6 15h8.8"/></svg>
                {%- when 'biome_safe' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M8 11a4.2 4.2 0 0 0 8 0"/><circle cx="9" cy="8.4" r=".9" fill="currentColor" stroke="none"/><circle cx="15" cy="8.4" r=".9" fill="currentColor" stroke="none"/></svg>
                {%- when 'fsc' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5.5 16h13L12 3Z"/><path d="M12 16v5"/></svg>
                {%- when 'glass' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18l-9 11L3 9Z"/><path d="M6.5 4h11L21 9H3l3.5-5Z"/></svg>
                {%- when 'organic' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20c0-7 5-12 11-12 0 6-4 11-11 12Z"/><path d="M4 20c2.5-4 5.5-6.5 9-8"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L4 6v6c0 5 3.6 9.4 8 10.8C16.4 21.4 20 17 20 12V6L12 2Z"/><path d="m9 12 2 2 4-4"/></svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-8-5.2-8-10.4A4.6 4.6 0 0 1 12 7a4.6 4.6 0 0 1 8 3.6C20 15.8 12 21 12 21Z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg>
              {%- endcase -%}
            </span>
            <span class="cred__trust-label">{{ block.settings.label }}</span>
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Credentials",
  "tag": "section",
  "class": "credentials-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Trust Us"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title (heading part)",
      "default": "Premium in ways"
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script line",
      "default": "that actually matter."
    },
    {
      "type": "header",
      "content": "Tile 1 (top-left, lavender)"
    },
    {
      "type": "text",
      "id": "tile1_icon",
      "label": "Emoji icon",
      "default": "\ud83e\uddec"
    },
    {
      "type": "text",
      "id": "tile1_title",
      "label": "Title",
      "default": "UBU Biome-Safe Formula"
    },
    {
      "type": "richtext",
      "id": "tile1_body",
      "label": "Body text",
      "default": "<p>Like a fingerprint, no two mouths are alike, and your formula shouldn\u2019t pretend otherwise. UBU\u2122 means every ingredient is biome-safe by design, working with your unique ecology instead of overwriting it.<\/p>"
    },
    {
      "type": "color",
      "id": "tile1_bg",
      "label": "Background color",
      "default": "#eeeaf8"
    },
    {
      "type": "header",
      "content": "Image 1 (top-center)"
    },
    {
      "type": "image_picker",
      "id": "image1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image1_alt",
      "label": "Alt text"
    },
    {
      "type": "header",
      "content": "Tile 2 (top-right, mint)"
    },
    {
      "type": "text",
      "id": "tile2_icon",
      "label": "Emoji icon",
      "default": "\ud83e\udda6"
    },
    {
      "type": "text",
      "id": "tile2_title",
      "label": "Title",
