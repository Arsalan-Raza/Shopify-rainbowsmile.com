    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#4b4f63"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Trust bar icon color",
      "default": "#232748"
    },
    {
      "type": "color",
      "id": "trust_label_color",
