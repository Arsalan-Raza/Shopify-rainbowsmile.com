    {
      "type": "header",
      "content": "Tile 3 (bottom-center, cream)"
    },
    {
      "type": "text",
      "id": "tile3_icon",
      "label": "Emoji icon",
      "default": "\ud83d\udd2c"
    },
    {
      "type": "text",
      "id": "tile3_title",
      "label": "Title",
      "default": "Science + Nature"
    },
    {
      "type": "richtext",
      "id": "tile3_body",
      "label": "Body text",
      "default": "<p>Your mouth is an ecosystem. Science has finally caught up to the powerful but often overlooked ecology inside you. A network of beneficial microbes lives in your mouth, quietly working to maintain optimal oral health. They need food. Rainbow Smile gives it to them.<\/p>"
    },
    {
      "type": "color",
      "id": "tile3_bg",
      "label": "Background color",
