    },
    {
      "type": "color",
      "id": "tile2_bg",
      "label": "Background color",
      "default": "#e9f1e4"
    },
    {
      "type": "header",
      "content": "Image 2 (bottom-left)"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image2_alt",
      "label": "Alt text"
