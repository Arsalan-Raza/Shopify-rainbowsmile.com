{%- style -%}
  #shopify-section-{{ section.id }} {
    --bd-navy:  {{ section.settings.navy_color }};
    --bd-coral: {{ section.settings.coral_color }};
    --bd-body:  {{ section.settings.body_color }};
    --bd-line:  {{ section.settings.line_color }};
    --bd-tint:  {{ section.settings.tint_color }};
    --bd-bg:    {{ section.settings.bg_color }};
  }
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .bid {
    background: var(--bd-bg);
    padding-block: clamp(44px, 6vw, 80px);
    padding-inline: clamp(20px, 5vw, 48px);
  }

  #shopify-section-{{ section.id }} .bid__inner { max-width: 1280px; margin-inline: auto; }

  /* ---------- Header ---------- */
  #shopify-section-{{ section.id }} .bid__head {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
    margin-bottom: clamp(34px, 5vw, 56px);
  }

  #shopify-section-{{ section.id }} .bid__eyebrow {
    margin: 0 0 clamp(12px, 2vw, 18px);
    font-family: var(--font-{{ section.settings.mono_font }}-family);
    font-weight: 700;
    font-size: clamp(14px, 1.1vw, 15px);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--bd-coral);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .bid__title {
    margin: 0;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 800;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.02;
    letter-spacing: -1px;
    color: var(--bd-navy);
  }
  #shopify-section-{{ section.id }} .bid__script {
    font-family: var(--font-{{ section.settings.script_font }}-family);
    font-weight: 400;
    font-size: 0.92em;
    letter-spacing: 0;
    color: var(--bd-coral);
    margin-left: 10px;
  }

  #shopify-section-{{ section.id }} .bid__intro { padding-top: clamp(6px, 3vw, 34px); }
  #shopify-section-{{ section.id }} .bid__intro p {
    margin: 0;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.6;
    color: var(--bd-body);
  }
  #shopify-section-{{ section.id }} .bid__intro p + p { margin-top: clamp(16px, 2.2vw, 22px); }

  /* ---------- Numbered list ---------- */
  #shopify-section-{{ section.id }} .bid__list {
    border: 1px solid var(--bd-line);
    border-radius: 16px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .bid__row {
    display: grid;
    grid-template-columns: clamp(88px, 10vw, 130px) 1fr;
    border-top: 1px solid var(--bd-line);
  }
  #shopify-section-{{ section.id }} .bid__row:first-child { border-top: none; }

  #shopify-section-{{ section.id }} .bid__num {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(24px, 3vw, 40px) 10px;
    background: var(--bd-tint);
    border-right: 1px solid var(--bd-line);
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 800;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1;
    color: var(--bd-coral);
  }

  #shopify-section-{{ section.id }} .bid__content {
    padding: clamp(22px, 3vw, 34px) clamp(20px, 3vw, 40px);
  }
  #shopify-section-{{ section.id }} .bid__row-title {
    margin: 0 0 10px;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.3;
    color: var(--bd-navy);
  }
  #shopify-section-{{ section.id }} .bid__row-body {
    margin: 0;
    font-family: var(--font-{{ section.settings.body_font }}-family);
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.6;
    color: var(--bd-body);
  }

  /* ---------- CTA ---------- */
  #shopify-section-{{ section.id }} .bid__cta-wrap {
    text-align: center;
    margin-top: clamp(34px, 5vw, 56px);
  }
  #shopify-section-{{ section.id }} .bid__cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 20px 40px;
    min-height: 60px;
    border-radius: 999px;
    background: var(--bd-coral);
    color: #fff;
    font-family: var(--font-{{ section.settings.heading_font }}-family);
    font-weight: 700;
    font-size: clamp(16px, 1.3vw, 17px);
    text-decoration: none;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }
  #shopify-section-{{ section.id }} .bid__cta span { transition: transform 0.18s ease; }
  #shopify-section-{{ section.id }} .bid__cta:hover { background: #dc411b; transform: translateY(-2px); }
  #shopify-section-{{ section.id }} .bid__cta:hover span { transform: translateX(3px); }
  #shopify-section-{{ section.id }} .bid__cta:focus-visible { outline: 3px solid rgba(239,74,34,0.45); outline-offset: 3px; }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .bid__head { grid-template-columns: 1fr; gap: clamp(20px, 4vw, 30px); }
    #shopify-section-{{ section.id }} .bid__intro { padding-top: 0; }
  }

  @media (max-width: 560px) {
    #shopify-section-{{ section.id }} .bid__row { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .bid__num {
      justify-content: flex-start;
      padding: clamp(18px, 4vw, 22px) clamp(20px, 5vw, 26px) 0;
      background: transparent;
      border-right: none;
    }
    #shopify-section-{{ section.id }} .bid__content { padding-top: 10px; }
    #shopify-section-{{ section.id }} .bid__cta { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .bid__cta:hover { transform: none; }
    #shopify-section-{{ section.id }} .bid__cta:hover span { transform: none; }
  }
</style>

{%- assign row_blocks = section.blocks | where: 'type', 'row' -%}

<section class="bid">
  <div class="bid__inner">

    <!-- Header -->
    <div class="bid__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="bid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank or section.settings.script_word != blank -%}
          <h2 class="bid__title">
            {{- section.settings.title | escape -}}
            {%- if section.settings.script_word != blank -%}
              <span class="bid__script">{{ section.settings.script_word | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
      </div>

      {%- if section.settings.intro != blank -%}
        <div class="bid__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    <!-- Numbered list -->
    {%- if row_blocks.size > 0 -%}
      <div class="bid__list">
        {%- for block in row_blocks -%}
          {%- assign num_display = forloop.index -%}
          <div class="bid__row" {{ block.shopify_attributes }}>
            <div class="bid__num">
              {%- if num_display < 10 -%}0{{ num_display }}{%- else -%}{{ num_display }}{%- endif -%}
            </div>
            <div class="bid__content">
              {%- if block.settings.row_title != blank -%}
                <h3 class="bid__row-title">{{ block.settings.row_title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.row_body != blank -%}
                <p class="bid__row-body">{{ block.settings.row_body | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- CTA -->
    {%- if section.settings.cta_text != blank -%}
      <div class="bid__cta-wrap">
        <a class="bid__cta" href="{{ section.settings.cta_url | default: '#' }}">
          {{ section.settings.cta_text | escape }} <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Community Identity",
  "tag": "section",
  "class": "community-identity-section",
  "blocks": [
    {
      "type": "row",
      "name": "Identity row",
      "settings": [
        {
          "type": "text",
          "id": "row_title",
          "label": "Row title"
        },
        {
          "type": "textarea",
          "id": "row_body",
          "label": "Row body"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Who We Are"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Biome Hacker is not"
    },
    {
      "type": "text",
      "id": "script_word",
      "label": "Script phrase (coral, inline)",
      "default": "a demographic."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro paragraphs (right column)",
      "default": "<p>They are defined by a particular relationship with the world \u2014 a willingness to look at the familiar and find it strange, a refusal to accept the received answer, and an intuition that the body already knows things medicine hasn\u2019t caught up with yet.<\/p><p>When they find the science of the oral microbiome, they don\u2019t feel like they\u2019ve learned something new. They feel like they\u2019ve remembered something they always knew.<\/p>"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Read the full Biome Hacker guide"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Fonts"
    },
    {
      "type": "select",
      "id": "mono_font",
      "label": "Eyebrow font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "tag"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Title & row title font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "script_font",
      "label": "Script phrase font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "accent"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body & intro font",
      "options": [
        { "value": "tag",     "label": "PP Neue Montreal Mono" },
        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "navy_color",
      "label": "Heading & row title",
      "default": "#232748"
    },
    {
      "type": "color",
      "id": "coral_color",
      "label": "Eyebrow, script, numbers & CTA",
      "default": "#ef4a22"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body & intro text",
      "default": "#4b4f63"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Borders & dividers",
      "default": "#ece7de"
    },
    {
      "type": "color",
      "id": "tint_color",
      "label": "Number column tint",
      "default": "#fdf6ef"
    }
  ],
  "presets": [
    {
      "name": "Community Identity",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "row_title": "They think of their body as a living ecosystem, not a machine",
            "row_body": "They came to this through functional medicine, biohacking, yoga, unexplained illness, or a single conversation. Ready for the science that confirms what they already sensed."
          }
        },
        {
          "type": "row",
          "settings": {
            "row_title": "They have already rejected conventional oral care",
            "row_body": "Not because they read a study. Because they noticed. The mouthwash felt wrong. Something in their body knew before their mind had the language for it."
          }
        },
        {
          "type": "row",
          "settings": {
            "row_title": "They hold science and spirit without needing to choose",
            "row_body": "A nurse who meditates, a microbiologist who does reiki, a data scientist who takes adaptogenic mushrooms. They don\u2019t experience these as contradictions."
          }
        },
        {
          "type": "row",
          "settings": {
            "row_title": "They share things that change them",
            "row_body": "When something works \u2014 really works \u2014 they tell their partner, their friend, their mother. Sharing is their natural response to transformation."
          }
        },
        {
          "type": "row",
          "settings": {
            "row_title": "They carry a sense of mission",
            "row_body": "Their health is connected to the health of their community and their world. Caring for their ecology is an act of care for the ecology around them."
          }
        }
      ]
    }
  ]
}
{% endschema %}
