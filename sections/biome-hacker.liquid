{%- style -%}
  /* ── Section wrapper — background + padding ─────────────────── */
  #shopify-section-{{ section.id }} {
    --bh-bg:     {{ section.settings.bg_color }};
    --bh-navy:   {{ section.settings.heading_color }};
    --bh-body:   {{ section.settings.body_color }};
    --bh-accent: {{ section.settings.accent_color }};

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--bh-bg);
    padding-top:    {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-inline: clamp(20px, 5vw, 40px);
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top:    {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Background image layer */
  #shopify-section-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    {%- if section.settings.bg_image != blank -%}
      background-image:    url("{{ section.settings.bg_image | image_url: width: 1800 }}");
      background-size:     cover;
      background-position: center;
      background-repeat:   no-repeat;
    {%- else -%}
      background-image: none;
    {%- endif -%}
    opacity: {{ section.settings.bg_image_opacity | divided_by: 100.0 }};
  }

  /* ── Inner ─────────────────────────────────────────────────── */
  .bh-{{ section.id }} * { box-sizing: border-box; }

  .bh-{{ section.id }} .bh__inner {
    max-width: 1120px;
    margin-inline: auto;
    text-align: center;
  }

  /* ── Eyebrow ───────────────────────────────────────────────── */
  .bh-{{ section.id }} .bh__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 clamp(14px, 2.5vw, 20px);
    font-family: var({{ section.settings.eyebrow_font }});
    font-weight: 500;
    font-size: clamp(12px, 1.2vw, 13px);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--bh-accent);
    line-height: 1;
  }
  .bh-{{ section.id }} .bh__eyebrow::before {
    content: "";
    width: 26px;
    height: 2px;
    background: currentColor;
    flex: none;
  }

  /* ── Heading ───────────────────────────────────────────────── */
  .bh-{{ section.id }} .bh__title {
    margin: 0;
    font-family: var({{ section.settings.heading_font }});
    font-weight: 700;
    font-size: clamp(34px, 5.4vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.5px;
    color: var(--bh-navy);
  }
  .bh-{{ section.id }} .bh__title sup {
    font-size: 0.42em;
    vertical-align: super;
  }

  /* ── Script line ───────────────────────────────────────────── */
  .bh-{{ section.id }} .bh__script {
    display: block;
    margin-top: 2px;
    font-family: var({{ section.settings.script_font }});
    font-weight: 400;
    font-size: clamp(32px, 4.8vw, 50px);
    line-height: 1.05;
    color: var(--bh-accent);
  }

  /* ── Body ──────────────────────────────────────────────────── */
  .bh-{{ section.id }} .bh__body {
    max-width: 900px;
    margin: clamp(28px, 4vw, 40px) auto 0;
  }
  .bh-{{ section.id }} .bh__body p {
    margin: 0;
    font-family: var({{ section.settings.body_font }});
    font-weight: 400;
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--bh-body);
  }
  .bh-{{ section.id }} .bh__body p + p {
    margin-top: clamp(18px, 2.5vw, 24px);
  }

  /* ── Mobile ────────────────────────────────────────────────── */
  @media screen and (max-width: 749px) {
    .bh-{{ section.id }} .bh__eyebrow { gap: 8px; }
    .bh-{{ section.id }} .bh__eyebrow::before { width: 20px; }
    .bh-{{ section.id }} .bh__body p { line-height: 1.72; }
  }
{%- endstyle -%}

<div class="bh-{{ section.id }}">
  <div class="bh__inner">

    {%- if section.settings.eyebrow_text != blank -%}
      <p class="bh__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading_text != blank or section.settings.script_text != blank -%}
      <h2 class="bh__title">
        {%- if section.settings.heading_text != blank -%}
          {{ section.settings.heading_text | escape }}
          {%- if section.settings.heading_sup != blank -%}
            <sup>{{ section.settings.heading_sup | escape }}</sup>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.script_text != blank -%}
          <span class="bh__script">{{ section.settings.script_text | escape }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <div class="bh__body">
        {{ section.settings.body_text }}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
