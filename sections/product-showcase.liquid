        { "value": "heading", "label": "D-DIN" },
        { "value": "accent",  "label": "Alkaline Test" }
      ],
      "default": "heading"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f4eee1"
    },
    {
      "type": "color",
      "id": "navy_color",
      "label": "Heading & text color",
      "default": "#232748"
    },
    {
      "type": "color",
      "id": "accent_color",
