{%- style -%}
  /* ── Section wrapper ───────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    --rev-bg:     {{ section.settings.bg_color }};
    --rev-navy:   {{ section.settings.navy_color }};
    --rev-accent: {{ section.settings.accent_color }};
    --rev-star:   {{ section.settings.star_color }};
    --rev-body:   {{ section.settings.body_color }};
    --rev-meta:   {{ section.settings.meta_color }};
    --rev-card:   {{ section.settings.card_color }};

    background: var(--rev-bg);
    padding-block: clamp(44px, 6vw, 76px);
    padding-inline: clamp(20px, 5vw, 48px);
  }

  .rev-{{ section.id }} * { box-sizing: border-box; }

  .rev-{{ section.id }} .rev__inner {
    max-width: 1180px;
    margin-inline: auto;
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .rev-{{ section.id }} .rev__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(20px, 3vw, 40px);
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .rev-{{ section.id }} .rev__title {
    margin: 0;
    font-family: var({{ section.settings.heading_font }});
    font-weight: 800;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: var(--rev-navy);
  }
  .rev-{{ section.id }} .rev__script {
    font-family: var({{ section.settings.script_font }});
    font-weight: 400;
    font-size: 1.06em;
    color: var(--rev-accent);
    margin-left: 6px;
  }

  /* ── Rating cluster ─────────────────────────────────────────── */
  .rev-{{ section.id }} .rev__rating { flex: none; text-align: left; }
  .rev-{{ section.id }} .rev__rating-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rev-{{ section.id }} .rev__score {
    font-family: var({{ section.settings.heading_font }});
    font-weight: 800;
    font-size: clamp(28px, 2.8vw, 34px);
    line-height: 1;
    letter-spacing: -0.5px;
    color: var(--rev-navy);
  }
  .rev-{{ section.id }} .rev__count {
    margin: 6px 0 0;
    font-family: var({{ section.settings.meta_font }});
    font-weight: 400;
    font-size: clamp(14px, 1.1vw, 15px);
    color: var(--rev-meta);
  }

  /* ── Stars ──────────────────────────────────────────────────── */
  .rev-{{ section.id }} .rev__stars {
    display: inline-flex;
    gap: 3px;
    color: var(--rev-star);
    line-height: 0;
  }
  .rev-{{ section.id }} .rev__stars svg {
    width: 14px;
    height: 14px;
    display: block;
  }
  .rev-{{ section.id }} .rev__rating .rev__stars svg { width: 15px; height: 15px; }
  .rev-{{ section.id }} .rev__star-filled { fill: currentColor; }
  .rev-{{ section.id }} .rev__star-empty  { fill: none; stroke: currentColor; stroke-width: 1.5px; }

  /* ── Slider ─────────────────────────────────────────────────── */
  .rev-{{ section.id }} .rev__slider-clip { overflow: hidden; }

  .rev-{{ section.id }} .rev__track {
    display: flex;
    gap: clamp(16px, 2vw, 24px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    align-items: stretch;
    padding-bottom: 4px; /* prevent card shadow clip */
  }
  .rev-{{ section.id }} .rev__track::-webkit-scrollbar { display: none; }
  .rev-{{ section.id }} .rev__track.is-dragging { cursor: grabbing; scroll-snap-type: none; }

  .rev-{{ section.id }} .rev__slide {
    flex: 0 0 calc((100% - clamp(32px, 4vw, 48px)) / 3);
    scroll-snap-align: start;
    display: flex;
  }

  /* ── Card ───────────────────────────────────────────────────── */
  .rev-{{ section.id }} .rev__card {
    background: var(--rev-card);
    border-radius: 10px;
    padding: clamp(22px, 2.4vw, 28px);
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .rev-{{ section.id }} .rev__quote {
    margin: 16px 0 clamp(22px, 3vw, 30px);
    font-family: var({{ section.settings.quote_font }});
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.65;
    color: var(--rev-body);
  }
  .rev-{{ section.id }} .rev__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }
  .rev-{{ section.id }} .rev__avatar {
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: linear-gradient(140deg, #cfd7e6, #e9d9c3);
  }
  .rev-{{ section.id }} .rev__name {
    margin: 0 0 4px;
    font-family: var({{ section.settings.name_font }});
    font-weight: 700;
    font-size: clamp(14px, 1.1vw, 15px);
    line-height: 1.2;
    color: var(--rev-navy);
  }
  .rev-{{ section.id }} .rev__meta {
    margin: 0;
    font-family: var({{ section.settings.meta_font }});
    font-weight: 400;
    font-size: clamp(14px, 1.1vw, 15px);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--rev-meta);
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media screen and (max-width: 899px) {
    .rev-{{ section.id }} .rev__head { flex-direction: column; align-items: flex-start; gap: 18px; }
  }
  @media screen and (max-width: 1023px) {
    .rev-{{ section.id }} .rev__slide {
      flex: 0 0 calc((100% - clamp(16px, 2vw, 24px)) / 2.2);
    }
  }
  @media screen and (max-width: 639px) {
    .rev-{{ section.id }} .rev__slide {
      flex: 0 0 calc(100% / 1.15);
    }
  }
{%- endstyle -%}

{%- comment -%} ── Pull aggregate rating from product metafields if available ── {%- endcomment -%}
{%- if product.metafields.reviews.rating != blank -%}
  {%- assign rating_display = product.metafields.reviews.rating.value.value | round: 1 -%}
{%- else -%}
  {%- assign rating_display = section.settings.rating_score -%}
{%- endif -%}

{%- if product.metafields.reviews.rating_count != blank -%}
  {%- assign count_display = product.metafields.reviews.rating_count.value | append: ' verified reviews' -%}
{%- else -%}
  {%- assign count_display = section.settings.review_count -%}
{%- endif -%}

{%- comment -%} Star SVGs ── reusable inline definitions {%- endcomment -%}
{%- capture star_filled -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path class="rev__star-filled" d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9 4.7 17.6l1-5.8L1.5 7.7l5.9-.9z"/></svg>{%- endcapture -%}
{%- capture star_empty -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path class="rev__star-empty" d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9 4.7 17.6l1-5.8L1.5 7.7l5.9-.9z"/></svg>{%- endcapture -%}

<div class="rev-{{ section.id }}">
  <div class="rev__inner">

    {%- comment -%} ── Header ── {%- endcomment -%}
    <header class="rev__head">
      <h2 class="rev__title">
        {{- section.settings.heading_text | escape -}}
        {%- if section.settings.script_text != blank -%}
          <span class="rev__script">{{ section.settings.script_text | escape }}</span>
        {%- endif -%}
      </h2>

      <div class="rev__rating">
        <div class="rev__rating-top">
          <span class="rev__score">{{ rating_display }}</span>
          <span class="rev__stars" role="img" aria-label="{{ rating_display }} out of 5 stars">
            {{ star_filled }}{{ star_filled }}{{ star_filled }}{{ star_filled }}{{ star_filled }}
          </span>
        </div>
        {%- if count_display != blank -%}
          <p class="rev__count">{{ count_display | escape }}</p>
        {%- endif -%}
      </div>
    </header>

    {%- comment -%} ── Slider ── {%- endcomment -%}
    {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
    {%- if review_blocks.size > 0 -%}
      <div class="rev__slider-clip">
        <div class="rev__track" id="rev-track-{{ section.id }}">
          {%- for block in review_blocks -%}
            <div class="rev__slide" {{ block.shopify_attributes }}>
              <article class="rev__card">

                {%- comment -%} Card stars ── based on block rating setting {%- endcomment -%}
                {%- assign card_rating = block.settings.rating -%}
                <span class="rev__stars" role="img" aria-label="{{ card_rating }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= card_rating -%}
                      {{ star_filled }}
                    {%- else -%}
                      {{ star_empty }}
                    {%- endif -%}
                  {%- endfor -%}
                </span>

                {%- if block.settings.quote != blank -%}
                  <p class="rev__quote">"{{ block.settings.quote | escape }}"</p>
                {%- endif -%}

                <div class="rev__author">
                  {%- if block.settings.avatar != blank -%}
                    {{
                      block.settings.avatar
                      | image_url: width: 72
                      | image_tag:
                        class: 'rev__avatar',
                        loading: 'lazy',
                        alt: block.settings.name | default: ''
                    }}
                  {%- else -%}
                    <span class="rev__avatar" aria-hidden="true"></span>
                  {%- endif -%}
                  <div>
                    {%- if block.settings.name != blank -%}
                      <p class="rev__name">{{ block.settings.name | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.meta != blank -%}
                      <p class="rev__meta">{{ block.settings.meta | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>

              </article>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var track = document.getElementById('rev-track-{{ section.id }}');
    if (!track) return;

    var startX, startScrollLeft, isDragging = false;

    track.addEventListener('mousedown', function (e) {
      isDragging = true;
      startX = e.pageX - track.offsetLeft;
      startScrollLeft = track.scrollLeft;
      track.classList.add('is-dragging');
    });

    document.addEventListener('mouseup', function () {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove('is-dragging');
    });

    document.addEventListener('mousemove', function (e) {
      if (!isDragging) return;
      e.preventDefault();
      var x = e.pageX - track.offsetLeft;
      var walk = (x - startX) * 1.2;
      track.scrollLeft = startScrollLeft - walk;
    });

    track.addEventListener('dragstart', function (e) { e.preventDefault(); });
  })();
</script>

