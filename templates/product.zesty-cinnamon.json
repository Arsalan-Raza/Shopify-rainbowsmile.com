    "miron_formulation_note_yyUmEq": {
      "type": "miron-formulation-note",
      "name": "Miron & Formulation Note",
      "settings": {
        "bg_color": "#ffffff",
        "rust_eyebrow": "Caring for your Miron glass bottle",
        "rust_title": "",
        "rust_body": "Store away from prolonged direct sunlight. The Miron violet glass is actively protecting the formulation — it transmits the beneficial infrared and UV-A spectrum while blocking the visible light that degrades bioactive ingredients. Keep the cap closed when not in use. The bottle is reusable and recyclable.",
        "rust_bg": "#b0512e",
        "rust_eyebrow_color": "#ffe8d9",
        "rust_title_color": "#fdeee4",
        "rust_body_color": "#fdeee4",
        "gold_eyebrow": "A note on our formulation",
        "gold_title": "",
        "gold_body_1": "OG3™ is designed to work <strong>with</strong> your oral microbiome, not against it. Every ingredient is certified organic and selected because the body recognises it. The oxygen infusion, EZ water, and biofield frequencies are properties of the formulation process — not additives. <strong>Nothing in any OG3™ product will harm your oral microbiome.</strong>",
        "gold_body_2": "Safe to swallow. If you are pregnant, nursing, or under medical supervision for an oral condition, consult your healthcare provider before use.",
        "gold_bg": "#f7e7bf",
        "gold_eyebrow_color": "#b79445",
        "gold_title_color": "#2a2410",
        "gold_body_color": "#4a4636",
        "fda_label": "FDA Disclosure",
        "fda_body_1": "These statements have not been evaluated by the Food and Drug Administration. OG3™ is not intended to diagnose, treat, cure, or prevent any disease. OG3™ is a dietary supplement. Results may vary between individuals. The information provided on this page is for educational purposes and is not a substitute for professional medical advice, diagnosis, or treatment. Always seek the advice of your physician or other qualified healthcare provider with any questions you may have regarding a medical condition. Do not disregard professional medical advice or delay seeking it because of information you have read here.",
        "fda_body_2": "If you are pregnant, nursing, taking prescription medication, or have a diagnosed health condition, consult your healthcare provider before use. Keep out of reach of children under 2 years of age. Store in a cool, dry place away from direct sunlight.",
        "fda_bg": "#fbf4ee",
        "fda_label_color": "#6b5f52",
        "fda_body_color": "#333333",
        "purple_color": "#7b2fd6",
        "green_color": "#3fae54"
      }
