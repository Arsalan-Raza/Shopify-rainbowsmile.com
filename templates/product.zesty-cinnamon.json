          "settings": {
            "label": "II — The Ecology",
            "icon_image": "shopify://shop_images/Diving.svg",
            "icon": "oxygen",
            "card_title": "Oxygen Infusion",
            "meta": "The ecology",
            "body": "OG3™ is infused with oxygen during manufacturing, creating the oxygen-rich environment where beneficial aerobic bacteria naturally thrive. Harmful anaerobic bacteria — responsible for bad breath and gum issues — cannot compete in oxygen-rich conditions. The ecology does the work."
          }
