            "card_title": "EZ Water · Structured Water",
            "meta": "The fourth phase",
            "body": "During manufacturing, OG3™ generates EZ water — structured, gel-like water in the same form found inside every living cell. Not added as an ingredient — created by how OG3™ is made. EZ water supports the biological activity of the formulation and the oral tissue it contacts."
          }
        },
        "pillar_YkpJUw": {
          "type": "pillar",
          "settings": {
            "label": "IV — The Protection",
            "icon_image": "shopify://shop_images/Luxury.svg",
