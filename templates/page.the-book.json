    "book_biome_hacker_47H7Yk": {
      "type": "book-biome-hacker",
      "blocks": {
        "card_R9UA8G": {
          "type": "card",
          "settings": {
            "num": "01",
            "title": "They think of their body as a living ecosystem, not a machine",
            "body": "They came to this through functional medicine, biohacking, yoga, unexplained illness, or a single conversation that opened something. They are ready for the science that confirms what they already sensed."
          }
        },
        "card_EiwqAP": {
          "type": "card",
          "settings": {
            "num": "02",
            "title": "They have already rejected conventional oral care",
            "body": "Not because they read a study. Because they noticed. The mouthwash felt wrong. Something in their body knew before their mind had the language for it."
          }
        },
        "card_Kam4BJ": {
          "type": "card",
          "settings": {
            "num": "03",
            "title": "They hold science and spirit without needing to choose",
            "body": "They might be a nurse who meditates, a microbiologist who does reiki, a data scientist who takes adaptogenic mushrooms. They don’t experience these as contradictions."
          }
        },
        "card_HNhjXx": {
          "type": "card",
          "settings": {
            "num": "04",
            "title": "They share things that change them",
            "body": "The Biome Hacker doesn’t keep discoveries to themselves. When something works — really works — they tell their partner, their friend, their mother. Sharing is their natural response to transformation."
          }
        },
        "card_c8CtCx": {
          "type": "card",
          "settings": {
            "num": "05",
            "title": "They sense needs before they’re spoken",
            "body": "This is quorum sensing at the human level. They are naturally empathic — they read rooms, they feel into relationships, they respond to what isn’t said. This is 3.5 billion years old."
          }
        },
        "card_JjadiB": {
          "type": "card",
          "settings": {
            "num": "06",
            "title": "They believe health is ecological, not chemical",
            "body": "You don’t fix a garden by poisoning it. You restore the conditions that let the right things grow. This is how they think about their body — and how they judge anything that claims to help it."
          }
        }
      },
