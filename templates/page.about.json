        "faq_item_dYPAKc": {
          "type": "faq_item",
          "settings": {
            "question": "What is Biome Food™?",
            "answer": "<p>Biome Food™ is our proprietary blend of prebiotic, microbiome-friendly nutrients that feed the beneficial bacteria in your mouth — helping your oral ecosystem stay balanced and thriving.</p>"
          }
        },
        "faq_item_GUMJtD": {
          "type": "faq_item",
          "settings": {
            "question": "What is OG3™?",
            "answer": "<p>OG3™ is our oxygen-rich oral care formula, designed to support the oral-gut axis with bioavailable oxygen and plant-based, microbiome-friendly compounds.</p>"
          }
        },
        "faq_item_cKDWNm": {
          "type": "faq_item",
          "settings": {
            "question": "How do I use the spray vs. the pump?",
            "answer": "<p>Use the spray for quick, on-the-go freshness, and the pump for your daily measured ritual. Both deliver the same OG3™ formula — choose whichever fits the moment.</p>"
          }
        },
        "faq_item_iD4JPp": {
          "type": "faq_item",
          "settings": {
            "question": "What does sublingual mean?",
            "answer": "<p>Sublingual means “under the tongue.” Holding the formula there briefly lets the active compounds absorb directly through the tissue for faster delivery.</p>"
          }
        },
        "faq_item_FTwDch": {
          "type": "faq_item",
          "settings": {
            "question": "Is it really safe to swallow?",
            "answer": "<p>Yes. Every ingredient is food-grade and designed to be swallowed safely, carrying its benefits along your oral-gut axis.</p>"
          }
        }
      },
