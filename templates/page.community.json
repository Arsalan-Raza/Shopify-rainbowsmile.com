      "blocks": {
        "row_xARMe7": {
          "type": "row",
          "settings": {
            "row_title": "They think of their body as a living ecosystem, not a machine",
            "row_body": "They came to this through functional medicine, biohacking, yoga, unexplained illness, or a single conversation. Ready for the science that confirms what they already sensed."
