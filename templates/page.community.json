        },
        "row_KbQzdL": {
          "type": "row",
          "settings": {
            "row_title": "They have already rejected conventional oral care",
            "row_body": "Not because they read a study. Because they noticed. The mouthwash felt wrong. Something in their body knew before their mind had the language for it."
          }
        },
        "row_zMNbTf": {
          "type": "row",
          "settings": {
            "row_title": "They hold science and spirit without needing to choose",
            "row_body": "A nurse who meditates, a microbiologist who does reiki, a data scientist who takes adaptogenic mushrooms. They don’t experience these as contradictions."
          }
        },
        "row_3XHDrf": {
          "type": "row",
          "settings": {
            "row_title": "They share things that change them",
            "row_body": "When something works — really works — they tell their partner, their friend, their mother. Sharing is their natural response to transformation."
          }
        },
        "row_dqJCW7": {
          "type": "row",
          "settings": {
            "row_title": "They carry a sense of mission",
            "row_body": "Their health is connected to the health of their community and their world. Caring for their ecology is an act of care for the ecology around them."
          }
        }
      },
