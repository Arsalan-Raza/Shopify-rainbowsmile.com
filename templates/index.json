      "blocks": {
        "faq_item_Kc4wNM": {
          "type": "faq_item",
          "settings": {
            "question": "Where do you ship?",
            "answer": "<p>We ship both within the U.S. and internationally.</p>"
          }
        },
        "faq_item_Kd9k9q": {
          "type": "faq_item",
          "settings": {
            "question": "How fast will my order arrive?",
            "answer": "<p>Within the U.S., shipping typically takes 2 days. International delivery times vary by location — some destinations may take a little longer, depending on where you're located.</p>"
          }
        },
        "faq_item_m9JMPF": {
          "type": "faq_item",
          "settings": {
            "question": "Is your packaging eco-friendly?",
            "answer": "<p><strong>Yes — every layer of it.</strong> Your order ships in a padded, 100% eco-friendly paper envelope, with the OG3™ tubes packed inside. The product itself comes in reusable, infinitely recyclable Miron violet glass. Sustainability isn't a separate initiative for us — it's consistent with a brand built around feeding ecosystems, not depleting them.</p>"
          }
        },
        "faq_item_ccdkgK": {
          "type": "faq_item",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>You'll receive a shipping confirmation email with a tracking link as soon as your order ships. You can also check order status anytime by logging into your account.</p>"
          }
        },
        "faq_item_eAG9zV": {
          "type": "faq_item",
          "settings": {
            "question": "Can I change or cancel my order after placing it?",
            "answer": "<p>Reach out as soon as possible after placing your order. Because we ship fast, we can only make changes or cancellations before the order has been processed for shipment — once it's on its way, we're not able to intercept it.</p>"
          }
        },
        "faq_item_TTzCCE": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship to PO boxes or APO/FPO addresses?",
            "answer": "<p>Yes, we ship to PO boxes and military APO/FPO addresses. Note that 2-day delivery isn't guaranteed to these addresses, as delivery times can vary with postal and military mail services.</p>"
          }
        },
        "faq_item_bRRMHy": {
          "type": "faq_item",
          "settings": {
            "question": "What if my order arrives damaged?",
            "answer": "<p>We're sorry if that happens — contact us with a photo of the damaged item and packaging, and we'll send a replacement or issue a full refund at no cost to you.</p>"
          }
        }
      },
