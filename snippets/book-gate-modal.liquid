<style>
  .bgm__overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(20, 24, 54, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .bgm__overlay.is-open {
    display: flex;
    animation: bgm-fade 0.22s ease;
  }
  @keyframes bgm-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .bgm__dialog {
    position: relative;
    width: 100%;
    max-width: 500px;
    background: #232a4d;
    border-radius: 20px;
    padding: clamp(32px, 5vw, 52px) clamp(24px, 5vw, 48px);
    text-align: center;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.5);
    max-height: 92vh;
    overflow-y: auto;
    animation: bgm-up 0.24s ease;
  }
  @keyframes bgm-up {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .bgm__close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border: none;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.55);
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }
  .bgm__close:hover { background: rgba(255, 255, 255, 0.16); color: #fff; }
  .bgm__close:focus-visible { outline: 2px solid rgba(255, 255, 255, 0.45); outline-offset: 2px; }

  .bgm__eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-tag-family);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #f5b842;
  }

  .bgm__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.06;
    letter-spacing: -0.4px;
    color: #fff;
  }

  .bgm__script {
    display: block;
    font-family: var(--font-accent-family);
    font-weight: 400;
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.2;
    color: #ef4a22;
    margin-top: 2px;
  }

  .bgm__body {
    margin: 14px auto 0;
    max-width: 360px;
    font-family: var(--font-heading-family);
    font-size: clamp(14px, 1.3vw, 16px);
    line-height: 1.55;
    color: #b6bbd2;
  }

  .bgm__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 380px;
    margin: 22px auto 0;
  }

  .bgm__input {
    width: 100%;
    min-height: 52px;
    padding: 15px 22px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    font-family: var(--font-heading-family);
    font-size: clamp(15px, 1.3vw, 16px);
    color: #fff;
    text-align: center;
    transition: border-color 0.16s ease, background 0.16s ease;
  }
  .bgm__input::placeholder { color: rgba(255, 255, 255, 0.33); }
  .bgm__input:focus {
    outline: none;
    border-color: #ef4a22;
    background: rgba(255, 255, 255, 0.09);
    box-shadow: 0 0 0 3px rgba(239, 74, 34, 0.22);
  }

  .bgm__error {
    margin: 2px 0 0;
    font-family: var(--font-tag-family);
    font-size: 12px;
    letter-spacing: 0.4px;
    color: #ff8a75;
  }

  .bgm__submit {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 15px 26px;
    border: none;
    border-radius: 999px;
    background: #ef4a22;
    color: #fff;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(15px, 1.3vw, 16px);
    cursor: pointer;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .bgm__submit:hover:not(:disabled) { background: #dc411b; transform: translateY(-2px); }
  .bgm__submit:focus-visible { outline: 3px solid rgba(239, 74, 34, 0.5); outline-offset: 3px; }
  .bgm__submit:disabled { opacity: 0.65; cursor: default; }

  .bgm__success {
    margin: 22px auto 0;
    max-width: 380px;
    padding: 20px 24px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.45;
  }
  .bgm__success-icon {
    display: block;
    margin: 0 auto 10px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #3fae54;
    color: #fff;
    font-size: 18px;
    line-height: 38px;
    text-align: center;
  }

  .bgm__fine {
    margin: 16px auto 0;
    max-width: 340px;
    font-family: var(--font-tag-family);
    font-size: 11px;
    letter-spacing: 0.3px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.28);
  }

  @media (prefers-reduced-motion: reduce) {
    .bgm__overlay.is-open, .bgm__dialog { animation: none; }
    .bgm__submit:hover { transform: none; }
  }
</style>

<div class="bgm__overlay" id="book-gate-modal" role="dialog" aria-modal="true" aria-labelledby="bgm-title">
  <div class="bgm__dialog">
    <button class="bgm__close" id="bgm-close" aria-label="Close">&#x2715;</button>

    <p class="bgm__eyebrow">Free Download</p>
    <h2 class="bgm__title" id="bgm-title">
      The Biome Hacker's Code.
      <span class="bgm__script">Get the full book.</span>
    </h2>
    <p class="bgm__body">All 12 chapters, free. Enter your email and we'll send it to your inbox instantly.</p>

    <form class="bgm__form" id="bgm-form" novalidate>
      <label for="bgm-email" hidden>Email address</label>
      <input
        class="bgm__input"
        id="bgm-email"
        type="email"
        name="email"
        placeholder="your@email.com"
        required
        autocomplete="email"
      >
      <p class="bgm__error" id="bgm-error" role="alert" hidden></p>
      <button class="bgm__submit" type="submit" id="bgm-submit">
        <span class="bgm__btn-label">Send me the book</span>
        <span aria-hidden="true">&#8594;</span>
      </button>
    </form>

    <p class="bgm__success" id="bgm-success" hidden>
      <span class="bgm__success-icon" aria-hidden="true">&#10003;</span>
      Check your inbox &mdash; the book is on its way.
    </p>

    <p class="bgm__fine">No spam. Unsubscribe anytime.</p>
  </div>
</div>

<script>
(function () {
  var modal     = document.getElementById('book-gate-modal');
  var form      = document.getElementById('bgm-form');
  var success   = document.getElementById('bgm-success');
  var errorEl   = document.getElementById('bgm-error');
  var submitBtn = document.getElementById('bgm-submit');
  var closeBtn  = document.getElementById('bgm-close');

  if (!modal) return;

  /* ── Open / close ──────────────────────────────────── */
  function openModal() {
    /* Reset state on each open */
    form.hidden = false;
    success.hidden = true;
    errorEl.hidden = true;
    form.reset();
    submitBtn.disabled = false;
    submitBtn.querySelector('.bgm__btn-label').textContent = 'Send me the book';

    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    setTimeout(function () {
      var emailInput = document.getElementById('bgm-email');
      if (emailInput) emailInput.focus();
    }, 60);
  }

  function closeModal() {
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeModal);

  /* Click outside dialog to close */
  modal.addEventListener('click', function (e) {
    if (e.target === modal) closeModal();
  });

  /* ESC key */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });

  /* ── Form submit → Klaviyo ─────────────────────────── */
  form.addEventListener('submit', function (e) {
    e.preventDefault();

    var email = document.getElementById('bgm-email').value.trim();

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errorEl.textContent = 'Please enter a valid email address.';
      errorEl.hidden = false;
      return;
    }
    errorEl.hidden = true;

    submitBtn.disabled = true;
    submitBtn.querySelector('.bgm__btn-label').textContent = 'Sending\u2026';

    fetch('https://a.klaviyo.com/client/subscriptions/?company_id=XPACnz', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'revision': '2024-02-15'
      },
      body: JSON.stringify({
        data: {
          type: 'subscription',
          attributes: {
            custom_source: 'Book Download Popup',
            profile: {
              data: {
                type: 'profile',
                attributes: { email: email }
              }
            }
          },
          relationships: {
            list: {
              data: { type: 'list', id: 'R9iaTf' }
            }
          }
        }
      })
    })
    .then(function (res) {
      if (res.status === 202 || res.ok) {
        form.hidden = true;
        success.hidden = false;
      } else {
        return res.json().then(function (body) {
          throw new Error(
            (body.errors && body.errors[0] && body.errors[0].detail) || 'Something went wrong.'
          );
        });
      }
    })
    .catch(function (err) {
      errorEl.textContent = err.message || 'Something went wrong. Please try again.';
      errorEl.hidden = false;
      submitBtn.disabled = false;
      submitBtn.querySelector('.bgm__btn-label').textContent = 'Send me the book';
    });
  });

  /* ── Global click intercept ────────────────────────── */
  /* Catches: [data-book-gate] elements + <a> links to /pages/the-book */
  document.addEventListener('click', function (e) {
    var node = e.target;
    while (node && node !== document.body) {
      if (node.hasAttribute && node.hasAttribute('data-book-gate')) {
        e.preventDefault();
        openModal();
        return;
      }
      if (node.tagName === 'A' && node.href) {
        var href = node.getAttribute('href') || '';
        var fullHref = node.href || '';
        if (
          href === 'shopify://pages/the-book' ||
          fullHref.indexOf('/pages/the-book') !== -1
        ) {
          /* Skip links inside the site header / nav — let those navigate normally */
          if (node.closest('header, nav, [role="navigation"], .header__inline-menu, .header-drawer')) {
            return;
          }
          e.preventDefault();
          openModal();
          return;
        }
      }
      node = node.parentElement;
    }
  }, true); /* capture phase so it fires before link navigation */

  /* Expose globally for direct JS calls */
  window.BookGateModal = { open: openModal, close: closeModal };
})();
</script>
